@model List<FormularioMaquinaria.Models.NovedadOperacion>

<div class="dropdown me-3">

    <button class="btn btn-light position-relative"
            data-bs-toggle="dropdown">

        <i class="fa-solid fa-bell"></i>

        @if (Model.Count > 0)
        {
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                @Model.Count
            </span>
        }

    </button>

    <ul class="dropdown-menu dropdown-menu-end shadow"
        style="width:360px;max-height:450px;overflow:auto;">

        <li class="dropdown-header fw-bold">

            Novedades activas

        </li>

        @if (Model.Count == 0)
        {
            <li class="dropdown-item text-muted">

                No hay novedades activas.

            </li>
        }
        else
        {
            @foreach (var alerta in Model)
            {
                <li>

                    <a href="#"
                       class="dropdown-item abrirNotificacion"
                       data-id="@alerta.Id">

                        <strong>
                            @alerta.Reporte?.NombreMaquina
                        </strong>

                        <br />

                        <small>
                            @alerta.TipoNovedad
                        </small>

                        <br />

                        <small class="text-danger">
                            Activa desde
                            @alerta.HoraInicio.ToString("dd/MM/yyyy HH:mm")
                        </small>

                    </a>

                </li>

                <li>
                    <hr class="dropdown-divider" />
                </li>
            }
        }

    </ul>

</div>