<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - FormularioMaquinaria</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/FormularioMaquinaria.styles.css"
          asp-append-version="true" />
</head>
<body>

    <!-- CONTENEDOR PRINCIPAL -->
    <div class="layout-container">

        <!-- SIDEBAR -->
        <aside id="sidebar" class="sidebar no-print">

            <!-- LOGO -->
            <div class="sidebar-header">

                <div class="sidebar-logo">
                    <i class="fa-solid fa-truck-monster"></i>
                </div>

                <h4>MAQUINARIAS</h4>

                <small>
                    Sistema de Gestión
                </small>

            </div>

            <hr />

            <!-- MENÚ -->
            <ul class="nav flex-column">

                <li class="nav-item">
                    <a asp-controller="Admin"
                       asp-action="Index"
                       class="nav-link">

                        <i class="fa-solid fa-house"></i>
                        <span>Dashboard</span>

                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Operadores"
                       asp-action="Index"
                       class="nav-link">

                        <i class="fa-solid fa-user-gear"></i>
                        <span>Operadores</span>

                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Maquinas"
                       asp-action="Index"
                       class="nav-link">

                        <i class="fa-solid fa-truck-monster"></i>
                        <span>Maquinaria</span>

                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Reporte"
                       asp-action="Crear"
                       class="nav-link">

                        <i class="fa-solid fa-square-plus"></i>
                        <span>Nuevo Reporte</span>

                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Reporte"
                       asp-action="Historial"
                       class="nav-link">

                        <i class="fa-solid fa-folder-open"></i>
                        <span>Historial</span>

                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Estadisticas"
                       asp-action="Index"
                       class="nav-link">

                        <i class="fa-solid fa-chart-column"></i>
                        <span>Estadísticas</span>

                    </a>
                </li>

                <li class="nav-item cerrar-sesion">
                    <a asp-controller="Login"
                       asp-action="Index"
                       class="nav-link">

                        <i class="fa-solid fa-right-from-bracket"></i>
                        <span>Cerrar sesión</span>

                    </a>
                </li>

            </ul>
        </aside>

        <!-- CONTENIDO -->
        <div class="contenido-layout">

            <!-- NAVBAR -->
            <nav class="navbar no-print">

                <!-- HAMBURGUESA -->
                <button id="btnMenu"
                        class="btn-menu"
                        type="button"
                        aria-label="Abrir menú">

                    <i class="fa-solid fa-bars"></i>

                </button>

                <!-- NOMBRE -->
                <div class="mobile-brand">
                    <strong>MAQUINARIAS</strong>
                </div>

                <!-- PARTE DERECHA -->
                <div class="navbar-right">

                    @await Component.InvokeAsync("Alertas")

                    <img src="https://ui-avatars.com/api/?name=Administrador&background=0f2f44&color=fff"
                         class="rounded-circle shadow"
                         width="38"
                         alt="Administrador">

                    <div class="user-info">

                        <strong>
                            Administrador
                        </strong>

                        <small>
                            En línea
                        </small>

                    </div>

                </div>

            </nav>


            <!-- CONTENIDO DE LA VISTA -->
            <main id="contenidoPrincipal">

                @RenderBody()

            </main>

        </div>

    </div>

    <!-- MODAL DETALLE NOTIFICACIÓN -->

    <div class="modal fade"
         id="modalNotificacion"
         tabindex="-1">

        <div class="modal-dialog modal-xl modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title"
                        id="tituloModalNotificacion">
                    </h5>

                    <button class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">

                    <div id="contenidoNotificacion">
                    </div>

                </div>

            </div>

        </div>

    </div>

        <script src="~/lib/jquery/dist/jquery.min.js"></script>

        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

        <script src="~/js/site.js" asp-append-version="true"></script>

        @await RenderSectionAsync("Scripts", required: false)
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

        document.addEventListener("click", async function (e) {

            const boton = e.target.closest(".abrirNotificacion");

            if (!boton)
                return;

            e.preventDefault();

            const id = boton.dataset.id;

            const respuesta = await fetch("/Admin/ObtenerNovedad?id=" + id);

            if (!respuesta.ok)
                return;

            const datos = await respuesta.json();
            console.log(datos);
            console.log(datos.evidenciaInicio);

            const header = document.querySelector("#modalNotificacion .modal-header");

            const titulo = document.getElementById("tituloModalNotificacion");

            if (datos.estado === "Activa") {

                header.className = "modal-header bg-danger text-white";

                titulo.innerHTML = `
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>
                    Novedad Activa
                `;

            }
            else {

                header.className = "modal-header bg-success text-white";

                titulo.innerHTML = `
                    <i class="fa-solid fa-circle-check me-2"></i>
                    Novedad Finalizada
                `;

            }

        document.getElementById("contenidoNotificacion").innerHTML = `

        <div class="row g-4">

            <div class="col-lg-6">

                <h4 class="fw-bold text-primary mb-4">
                    ${datos.maquina}
                </h4>

                <table class="table align-middle">

                <tbody>

                    <tr>
                        <th style="width:150px;">Operador</th>
                        <td>${datos.operador}</td>
                    </tr>

                    <tr>
                        <th>Tipo</th>
                        <td>${datos.tipo}</td>
                    </tr>

                    <tr>
                        <th>Estado</th>

                        <td>

                            <span class="badge rounded-pill ${
                                datos.estado === "Activa"
                                    ? "bg-danger"
                                    : "bg-success"
                            }">

                                ${datos.estado}

                            </span>

                        </td>

                    </tr>

            <div class="border rounded-3 p-3 mb-3">

            <h6 class="fw-bold mb-3">

                Línea de tiempo

            </h6>

            <div class="d-flex">

                <div class="me-3 text-center">

                    <i class="fa-solid fa-circle text-success"></i>

                    <br>

                    <i class="fa-solid fa-grip-lines-vertical text-secondary"></i>

                    <br>

                    <i class="fa-solid fa-circle ${datos.estado === "Activa"
                        ? "text-danger"
                        : "text-success"}"></i>

                        </div>

                        <div>

                            <div class="mb-4">

                                <strong>Inicio</strong>

                                <br>

                                <small class="text-muted">

                                    ${datos.horaInicio}

                                </small>

                            </div>

                            <div>

                                <strong>Fin</strong>

                                <br>

                                <small class="text-muted">

                                    ${datos.horaFin ?? "Aún no finaliza"}

                                </small>

                            </div>

                        </div>

                    </div>

                </div>

                </tbody>

                </table>

                <div class="border rounded-3 p-3 bg-light mb-3">

                    <div class="d-flex align-items-center">

                        <i class="fa-regular fa-clock text-danger fs-4 me-3"></i>

                        <div>

                            <small class="text-muted">

                                Tiempo fuera de servicio

                            </small>

                            <h4 class="text-danger fw-bold mb-0">

                                ${datos.duracion}

                            </h4>

                        </div>

                    </div>

                </div>

                <div class="border rounded-3 p-3">

                    <h6 class="fw-bold">

                        Observación

                    </h6>

                    <hr>

                    <p class="mb-0">

                        ${datos.observacion}

                    </p>

                </div>

            </div>

            <div class="col-lg-6">

                <div class="card shadow-sm mb-3">

                    <div class="card-header fw-bold">

                        Evidencia inicial

                    </div>

                    <div class="card-body text-center">

                        ${
                            datos.evidenciaInicio

                            ? `
                            <a href="${datos.evidenciaInicio}" target="_blank">

                                <img src="${datos.evidenciaInicio}"
                                     class="img-fluid rounded"
                                     style="height:220px;width:100%;object-fit:cover;cursor:pointer;">

                            </a>
                            `

                            : "<p class='text-muted'>Sin evidencia.</p>"
                        }

                    </div>

                </div>

                
            </div>

        </div>

        `;

            new bootstrap.Modal(
                document.getElementById("modalNotificacion")
            ).show();

        });

    </script>
    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const btnMenu = document.getElementById("btnMenu");
            const sidebar = document.getElementById("sidebar");
            const contenido = document.querySelector(".contenido-layout");

            if (!btnMenu || !sidebar)
                return;

            btnMenu.addEventListener("click", function () {

                sidebar.classList.toggle("sidebar-open");

                if (contenido) {
                    contenido.classList.toggle("sidebar-visible");
                }

                const icon = btnMenu.querySelector("i");

                if (sidebar.classList.contains("sidebar-open")) {

                    icon.classList.remove("fa-bars");
                    icon.classList.add("fa-xmark");

                } else {

                    icon.classList.remove("fa-xmark");
                    icon.classList.add("fa-bars");

                }

            });

        });

    </script>
</body>
</html>
