<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - FormularioMaquinaria</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/FormularioMaquinaria.styles.css"
          asp-append-version="true" />
</head>
<body>

    <!-- CONTENEDOR PRINCIPAL -->
    <div class="layout-container">

        <!-- SIDEBAR -->
        <aside id="sidebar" class="sidebar no-print">

            <!-- BOTÓN CERRAR -->
            <button id="btnCerrarSidebar"
                    type="button"
                    class="btn-cerrar-sidebar"
                    aria-label="Cerrar menú">
                <i class="fa-solid fa-xmark"></i>
            </button>

            <!-- LOGO -->
            <div class="sidebar-header">
                <div class="sidebar-logo">
                    <i class="fa-solid fa-truck-monster"></i>
                </div>
                <h4>MAQUINARIAS</h4>
                <small>Sistema de Gestión</small>
            </div>

            <hr />

            <!-- MENÚ -->
            <ul class="nav flex-column">

                <li class="nav-item">
                    <a asp-controller="Admin"
                       asp-action="Index"
                       class="nav-link">
                        <i class="fa-solid fa-house"></i>
                        <span>Dashboard</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Operadores"
                       asp-action="Index"
                       class="nav-link">
                        <i class="fa-solid fa-user-gear"></i>
                        <span>Operadores</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Maquinas"
                       asp-action="Index"
                       class="nav-link">
                        <i class="fa-solid fa-truck-monster"></i>
                        <span>Equipos</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Reporte"
                       asp-action="Historial"
                       class="nav-link">
                        <i class="fa-solid fa-folder-open"></i>
                        <span>Reporte Maquinaria</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="ViajeMaterial"
                       asp-action="Reporte"
                       class="nav-link">
                        <i class="fa-solid fa-truck"></i>
                        <span>Reporte de Viajes</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Estadisticas"
                       asp-action="Index"
                       class="nav-link">
                        <i class="fa-solid fa-chart-column"></i>
                        <span>Estadísticas</span>
                    </a>
                </li>

                <li class="nav-item cerrar-sesion">
                    <a asp-controller="Login"
                       asp-action="Index"
                       class="nav-link">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        <span>Cerrar sesión</span>
                    </a>
                </li>

            </ul>
        </aside>

        <!-- CONTENIDO -->
        <div class="contenido-layout">

            <!-- NAVBAR -->
            <nav class="navbar no-print">

                <!-- HAMBURGUESA -->
                <button id="btnMenu"
                        class="btn-menu"
                        type="button"
                        aria-label="Abrir menú">
                    <i class="fa-solid fa-bars"></i>
                </button>

                <!-- NOMBRE -->
                <div class="mobile-brand">
                    <strong>DASHBOARD</strong>
                </div>

                <!-- PARTE DERECHA -->
                <div class="navbar-right d-flex align-items-center gap-3">

                    <!-- CAMPANA DE NOTIFICACIONES INTERACTIVA -->
                    <div class="dropdown" id="contenedorCampana">
                        <button class="btn btn-light rounded-circle shadow-sm position-relative d-flex align-items-center justify-content-center"
                                type="button"
                                id="dropdownCampana"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"
                                style="width: 42px; height: 42px; border: 1px solid #eaeaea;"
                                title="Notificaciones">
                            <i class="fa-solid fa-bell text-secondary" id="iconoCampana" style="font-size: 18px;"></i>
                            
                            <!-- Badge contador flotante -->
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                  id="contadorNotificaciones"
                                  style="display: none; font-size: 10px; border: 2px solid #fff;">
                                0
                            </span>
                        </button>

                        <!-- Menú desplegable de notificaciones -->
                        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2 p-0"
                            aria-labelledby="dropdownCampana"
                            style="width: 320px; border-radius: 14px; overflow: hidden;">
                            
                            <li class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center">
                                <span class="fw-bold text-dark m-0" style="font-size: 14px;">
                                    <i class="fa-solid fa-bell text-primary me-1"></i> Notificaciones
                                </span>
                                <span class="badge bg-primary rounded-pill" id="badgeTotalNotif" style="font-size: 11px;">0 nuevas</span>
                            </li>

                            <div id="listaNotificaciones" style="max-height: 280px; overflow-y: auto;">
                                <li class="p-4 text-center text-muted small">
                                    <i class="fa-solid fa-check-circle fa-2x mb-2 text-success opacity-50"></i>
                                    <p class="mb-0">No hay notificaciones pendientes</p>
                                </li>
                            </div>
                            
                            <li class="p-2 bg-light text-center border-top">
                                <a href="javascript:void(0);" class="text-decoration-none small fw-semibold text-primary" onclick="marcarTodasLeidas()">
                                    Marcar todo como leído
                                </a>
                            </li>
                        </ul>
                    </div>

                    <!-- AUDIO OCULTO PARA ALERTA -->
                    <audio id="audioNotificacion" src="https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3" preload="auto"></audio>

                    <!-- AVATAR Y DATOS DEL ADMINISTRADOR -->
                    <div class="d-flex align-items-center gap-2 border-start ps-3">
                        <img src="https://ui-avatars.com/api/?name=Administrador&background=0f2f44&color=fff"
                             class="rounded-circle shadow-sm"
                             width="38"
                             height="38"
                             alt="Administrador">

                        <div class="user-info d-none d-sm-block">
                            <strong class="d-block text-dark" style="font-size: 14px; line-height: 1.2;">
                                Administrador
                            </strong>
                            <small class="text-success fw-semibold" style="font-size: 11px;">
                                ● En línea
                            </small>
                        </div>
                    </div>

                </div>

            </nav>

            <!-- CONTENIDO DE LA VISTA -->
            <main id="contenidoPrincipal">
                @RenderBody()
            </main>

        </div>

    </div>

    <!-- MODAL DETALLE NOTIFICACIÓN -->
    <div class="modal fade"
         id="modalNotificacion"
         tabindex="-1">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"
                        id="tituloModalNotificacion">
                    </h5>
                    <button class="btn-close"
                            data-bs-dismiss="modal">
                    </button>
                </div>
                <div class="modal-body">
                    <div id="contenidoNotificacion">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>