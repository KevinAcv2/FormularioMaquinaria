<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - FormularioMaquinaria</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/FormularioMaquinaria.styles.css"
          asp-append-version="true" />
</head>
<body>

    <!-- CONTENEDOR PRINCIPAL -->
    <div class="layout-container">

        <!-- SIDEBAR -->
        <aside id="sidebar" class="sidebar no-print">

            <!-- BOTÓN CERRAR -->
            <button id="btnCerrarSidebar"
                    type="button"
                    class="btn-cerrar-sidebar"
                    aria-label="Cerrar menú">

                <i class="fa-solid fa-xmark"></i>

            </button>

            <!-- LOGO -->
            <div class="sidebar-header">

                <div class="sidebar-logo">
                    <i class="fa-solid fa-truck-monster"></i>
                </div>

                <h4>MAQUINARIAS</h4>

                <small>
                    Sistema de Gestión
                </small>

            </div>

            <hr/>

            <!-- MENÚ -->
            <ul class="nav flex-column">

                <li class="nav-item">
                    <a asp-controller="Admin"
                       asp-action="Index"
                       class="nav-link">

                        <i class="fa-solid fa-house"></i>
                        <span>Dashboard</span>

                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Operadores"
                       asp-action="Index"
                       class="nav-link">

                        <i class="fa-solid fa-user-gear"></i>
                        <span>Operadores</span>

                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Maquinas"
                       asp-action="Index"
                       class="nav-link">

                        <i class="fa-solid fa-truck-monster"></i>
                        <span>Maquinaria</span>

                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Reporte"
                       asp-action="Historial"
                       class="nav-link">

                        <i class="fa-solid fa-folder-open"></i>
                        <span>Historial</span>

                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Estadisticas"
                       asp-action="Index"
                       class="nav-link">

                        <i class="fa-solid fa-chart-column"></i>
                        <span>Estadísticas</span>

                    </a>
                </li>

                <li class="nav-item cerrar-sesion">
                    <a asp-controller="Login"
                       asp-action="Index"
                       class="nav-link">

                        <i class="fa-solid fa-right-from-bracket"></i>
                        <span>Cerrar sesión</span>

                    </a>
                </li>

            </ul>
        </aside>

        <!-- CONTENIDO -->
        <div class="contenido-layout">

            <!-- NAVBAR -->
            <nav class="navbar no-print">

                <!-- HAMBURGUESA -->
                <button id="btnMenu"
                        class="btn-menu"
                        type="button"
                        aria-label="Abrir menú">

                    <i class="fa-solid fa-bars"></i>

                </button>

                <!-- NOMBRE -->
                <div class="mobile-brand">
                    <strong>MAQUINARIAS</strong>
                </div>

                <!-- PARTE DERECHA -->
                <div class="navbar-right">

                    @await Component.InvokeAsync("Alertas")

                    <img src="https://ui-avatars.com/api/?name=Administrador&background=0f2f44&color=fff"
                         class="rounded-circle shadow"
                         width="38"
                         alt="Administrador">

                    <div class="user-info">

                        <strong>
                            Administrador
                        </strong>

                        <small>
                            En línea
                        </small>

                    </div>

                </div>

            </nav>


            <!-- CONTENIDO DE LA VISTA -->
            <main id="contenidoPrincipal">

                @RenderBody()

            </main>

        </div>

    </div>

    <!-- MODAL DETALLE NOTIFICACIÓN -->

    <div class="modal fade"
         id="modalNotificacion"
         tabindex="-1">

        <div class="modal-dialog modal-xl modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title"
                        id="tituloModalNotificacion">
                    </h5>

                    <button class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">

                    <div id="contenidoNotificacion">
                    </div>

                </div>

            </div>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
