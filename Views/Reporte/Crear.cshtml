@model FormularioMaquinaria.Models.ReporteMaquinaria
@{
    Layout = null;
}

@{
    ViewData["Title"] = "Reporte de Maquinaria";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="~/css/crear-reporte.css" asp-append-version="true" />

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-lg card-industrial">

                <div class="header-industrial">

                    <img src="/img/Logo.png"
                         class="logo-empresa"
                         alt="Logo Empresa" />

                    <h1 class="titulo-principal">
                        AVENIDA DEL RÍO
                    </h1>

                    <p class="subtitulo">
                        Sistema de Control Operacional de Maquinaria Pesada
                    </p>

                </div>

                <div class="card-body">

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            @ViewBag.Error
                        </div>
                    }

                    <form id="formReporte"
                          asp-action="Crear"
                          method="post"
                          enctype="multipart/form-data">

                        <input type="hidden"
                               id="NovedadesJson"
                               name="NovedadesJson" />

                        <input type="file"
                               id="EvidenciaNovedadForm"
                               name="EvidenciaNovedad"
                               hidden />

                        <div class="mb-4">

                            <label class="form-label">
                                Nombre del Operador
                            </label>

                            <select asp-for="NombreOperador"
                                    id="operador"
                                    asp-items="ViewBag.Operadores"
                                    class="form-select">

                                <option value="">
                                    Seleccione un operador
                                </option>

                            </select>

                        </div>  
                        
                        <div class="mb-4">

                            <label class="form-label">
                                Nombre del Frente Operacional
                            </label>

                            <select name="FrenteOperacional"
                                    class="form-select"
                                    required>

                                <option value="">Seleccione un frente</option>

                                <option value="Padel">
                                    Frente Padel
                                </option>

                                <option value="Panama">
                                    Frente Panamá
                                </option>

                            </select>

                        </div>

                        <div class="mb-4">

                            <label class="form-label">
                                Máquina/Tipo
                            </label>

                            <input asp-for="NombreMaquina"
                                   id="nombreMaquina"
                                   class="form-control"
                                   readonly />

                        </div>

                        <div class="mb-4">

                            <label class="form-label">
                                Estado de la Máquina
                            </label>

                            <select asp-for="EstadoMaquina"
                                    id="estadoMaquina"
                                    class="form-select">

                                <option value="">Seleccione un estado</option>

                                <option value="1">
                                    OPERATIVA
                                </option>

                                <option value="0">
                                    NO OPERATIVA
                                </option>

                            </select>

                        </div>

                        <input type="hidden"
                               asp-for="TipoMaquina"
                               value="N/A" />
                        <div class="row">

                            <div class="col-md-6 mb-4">

                                <label class="form-label">
                                    Horómetro Inicial
                                </label>

                                <input asp-for="HorometroInicial"
                                       id="horometroInicial"
                                       class="form-control form-control-lg"/>

                            </div>

                            <div class="col-md-6 mb-4">

                                <label class="form-label">
                                    Horómetro Final
                                </label>

                                <input asp-for="HorometroFinal"
                                       id="horometroFinal"
                                       class="form-control form-control-lg"/>

                            </div>


                        </div>

                        <hr />

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label class="form-label fw-bold">
                                    Foto Horómetro Inicial
                                </label>

                                <input type="file"
                                       id="fotoInicial"
                                       name="fotoInicial"
                                       class="form-control"
                                       accept="image/*" />

                            </div>

                            <div class="col-md-6 mb-3">

                                <label class="form-label fw-bold">
                                    Foto Horómetro Final
                                </label>

                                <input type="file"
                                       id="fotoFinal"
                                       name="fotoFinal"
                                       class="form-control"
                                       accept="image/*" />

                            </div>

                        </div>

                        <div class="mb-4">

                            <label class="form-label">
                                Observaciones Operacionales
                            </label>

                            <textarea asp-for="Observaciones"
                                      id="observaciones"
                                      class="form-control"
                                      rows="4" 
                                      placeholder="Escriba cualquiero observacion del reporte">
                            </textarea>

                        </div>

                        <hr class="my-4" />

                        <h5 class="fw-bold">
                            <i class="fa-solid fa-list-check text-warning"></i>
                            Novedades registradas
                        </h5>

                        <div id="listaNovedades">

                            <div class="alert alert-light text-muted">

                                No hay novedades registradas.

                            </div>

                        </div>

                        <button type="submit"
                                class="btn btn-industrial w-100">

                            ENVIAR REPORTE OPERACIONAL

                        </button>
                        
                    </form>
                    
                </div>

            </div>

        </div>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    window.mensajeExito = '@TempData["Exito"]';
</script>

<script src="~/js/CrearReporte.js" asp-append-version="true"></script>

<!-- MODAL REGISTRAR NOVEDAD  -->

<div class="modal fade"
     id="modalNovedad"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title fw-bold">

                    <i class="fa-solid fa-triangle-exclamation text-warning me-2"></i>

                    Registrar Novedad

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <div class="mb-3">

                    <label class="form-label fw-bold">

                        Tipo de novedad

                    </label>

                    <select id="TipoNovedad"
                            class="form-select">

                        <option value="">
                            Seleccione...
                        </option>

                        <option>Daño Mecánico</option>
                        <option>Falta de Combustible</option>
                        <option>Mantenimiento</option>
                        <option>Espera de Material</option>
                        <option>Cambio de Operador</option>
                        <option>Condiciones Climáticas</option>
                        <option>Otro</option>

                    </select>

                </div>

                <div class="mb-3">

                    <label class="form-label fw-bold">

                        Observación

                    </label>

                    <textarea id="ObservacionNovedad"
                              class="form-control"
                              rows="5"
                              placeholder="Describe la novedad..."></textarea>

                    <div class="mb-3">

                        <label class="form-label fw-bold">
                            Evidencia (Foto)
                        </label>

                        <input type="file"
                               id="EvidenciaNovedad"
                               name="EvidenciaNovedad"
                               class="form-control"
                               accept="image/*"
                               capture=""/>

                        <small class="text-muted">
                            Puede seleccionar una fotografía o tomarla desde el dispositivo.
                        </small>

                    </div>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Cancelar

                </button>

                <button type="button"
                        id="btnGuardarNovedad"
                        class="btn btn-warning">

                    <i class="fa-solid fa-floppy-disk me-2"></i>

                    Guardar Novedad

                </button>

            </div>

        </div>

    </div>

</div>

<!-- MODAL FINALIZAR NOVEDAD -->

<div class="modal fade"
     id="modalFinalizarNovedad"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title fw-bold">
                    Finalizar novedad
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <input type="hidden" id="IdReporteTemporal" />

                <div class="mb-3">

                    <label class="form-label fw-bold">
                        Observación de cierre
                    </label>

                    <textarea id="ObservacionFin"
                              class="form-control"
                              rows="4"
                              placeholder="Describa cómo se solucionó la novedad...">
                    </textarea>

                </div>

                <div class="mb-3">

                    <label class="form-label fw-bold">
                        Evidencia de reparación
                    </label>

                    <input type="file"
                           id="EvidenciaFin"
                           class="form-control"
                           accept="image/*"
                           capture="" />

                </div>

            </div>

            <div class="modal-footer">

                <button class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button id="btnFinalizarNovedad"
                        class="btn btn-success">

                    Finalizar novedad

                </button>

            </div>

        </div>

    </div>

</div>