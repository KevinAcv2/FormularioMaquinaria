@model FormularioMaquinaria.Models.ReporteMaquinaria
@{
    Layout = null;
}

@{
    ViewData["Title"] = "Reporte de Maquinaria";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="~/css/CrearReporte.css" asp-append-version="true" />

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-lg card-industrial">

                <div class="header-industrial">

                    <img src="/img/Logo.png"
                         class="logo-empresa"
                         alt="Logo Empresa" />

                    <h1 class="titulo-principal">
                        AVENIDA DEL RÍO
                    </h1>

                    <p class="subtitulo">
                        Sistema de Control Operacional de Maquinaria Pesada
                    </p>

                </div>

                <div class="card-body">

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            @ViewBag.Error
                        </div>
                    }

                    <form id="formReporte"
                          asp-action="Crear"
                          method="post"
                          enctype="multipart/form-data">

                        <div class="mb-4">

                            <label class="form-label">
                                Nombre del Operador
                            </label>

                            <select asp-for="NombreOperador"
                                    id="operador"
                                    asp-items="ViewBag.Operadores"
                                    class="form-select">

                                <option value="">
                                    Seleccione un operador
                                </option>

                            </select>

                        </div>  
                        
                        <div class="mb-4">

                            <label class="form-label">
                                Nombre del Frente Operacional
                            </label>

                            <select name="FrenteOperacional"
                                    class="form-select"
                                    required>

                                <option value="">Seleccione un frente</option>

                                <option value="Padel">
                                    Frente Padel
                                </option>

                                <option value="Panama">
                                    Frente Panamá
                                </option>

                            </select>

                        </div>

                        <div class="mb-4">

                            <label class="form-label">
                                Máquina/Tipo
                            </label>

                            <input asp-for="NombreMaquina"
                                   id="nombreMaquina"
                                   class="form-control"
                                   readonly />

                        </div>

                        <div class="mb-4">

                            <label class="form-label">
                                Estado de la Máquina
                            </label>

                            <select asp-for="EstadoMaquina"
                                    id="estadoMaquina"
                                    class="form-select">

                                <option value="">Seleccione un estado</option>

                                <option value="1">
                                    OPERATIVA
                                </option>

                                <option value="0">
                                    NO OPERATIVA
                                </option>

                            </select>

                        </div>

                        <input type="hidden"
                               asp-for="TipoMaquina"
                               value="N/A" />
                        <div class="row">

                            <div class="col-md-6 mb-4">

                                <label class="form-label">
                                    Horómetro Inicial
                                </label>

                                <input asp-for="HorometroInicial"
                                       id="horometroInicial"
                                       class="form-control form-control-lg"/>

                            </div>

                            <div class="col-md-6 mb-4">

                                <label class="form-label">
                                    Horómetro Final
                                </label>

                                <input asp-for="HorometroFinal"
                                       id="horometroFinal"
                                       class="form-control form-control-lg"/>

                            </div>


                        </div>

                        <hr />

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label class="form-label fw-bold">
                                    Foto Horómetro Inicial
                                </label>

                                <input type="file"
                                       id="fotoInicial"
                                       name="fotoInicial"
                                       class="form-control"
                                       accept="image/*" />

                            </div>

                            <div class="col-md-6 mb-3">

                                <label class="form-label fw-bold">
                                    Foto Horómetro Final
                                </label>

                                <input type="file"
                                       id="fotoFinal"
                                       name="fotoFinal"
                                       class="form-control"
                                       accept="image/*" />

                            </div>

                        </div>

                        <div class="mb-4">

                            <label class="form-label">
                                Observaciones Operacionales
                            </label>

                            <textarea asp-for="Observaciones"
                                      class="form-control"
                                      rows="4" 
                                      placeholder="Escriba cualquiero observacion del reporte">
                            </textarea>

                        </div>

                        <button type="submit"
                                class="btn btn-industrial w-100">

                            ENVIAR REPORTE OPERACIONAL

                        </button>

                        <a href="/Inicio/Index"
                           class="btn btn-secondary btn-dashboard w-100 mt-3">

                            VOLVER AL INICIO

                        </a>
                        
                    </form>
                    
                </div>

            </div>

        </div>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    window.mensajeExito = '@TempData["Exito"]';
</script>

<script src="~/js/CrearReporte.js" asp-append-version="true"></script>