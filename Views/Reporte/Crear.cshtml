@model Maquinarias.Models.ReporteMaquinaria

@{
    ViewData["Title"] = "Reporte de Maquinaria";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

    body {
        background: linear-gradient(rgba(0,0,0,.75), rgba(0,0,0,.75)), url('https://images.unsplash.com/photo-1504307651254-35680f356dfd?q=80&w=2070');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        min-height: 100vh;
    }

    .card-industrial {
        border-radius: 25px;
        overflow: hidden;
        border: none;
        background: rgba(255,255,255,0.96);
        backdrop-filter: blur(10px);
    }

    .header-industrial {
        background: #0f2f44;
        padding: 35px;
        text-align: center;
        color: white;
    }

    .logo-empresa {
        width: 140px;
        height: 140px;
        object-fit: cover;
        border-radius: 50%;
        border: 5px solid #f0ad00;
        margin-bottom: 15px;
        box-shadow: 0px 0px 20px rgba(0,0,0,.4);
    }

    .titulo-principal {
        font-size: 32px;
        font-weight: 800;
        letter-spacing: 1px;
    }

    .subtitulo {
        color: #d6d6d6;
        font-size: 15px;
    }

    .form-label {
        color: #0f2f44;
        font-weight: 700;
    }

    .form-control,
    .form-select {
        border-radius: 12px;
        padding: 14px;
        border: 2px solid #d9d9d9;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #f0ad00;
            box-shadow: 0 0 0 .2rem rgba(240,173,0,.25);
        }

    .btn-industrial {
        background: #f0ad00;
        color: #000;
        border: none;
        padding: 15px;
        font-size: 18px;
        font-weight: 800;
        border-radius: 12px;
        transition: .3s;
    }

        .btn-industrial:hover {
            background: #d89b00;
            transform: scale(1.02);
        }

    .card-body {
        padding: 50px;
    }

</style>

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-lg card-industrial">

                <div class="header-industrial">

                    <img src="/img/Logo.png"
                         class="logo-empresa"
                         alt="Logo Empresa" />

                    <h1 class="titulo-principal">
                        AVENIDA DEL RÍO
                    </h1>

                    <p class="subtitulo">
                        Sistema de Control Operacional de Maquinaria Pesada
                    </p>

                </div>

                <div class="card-body">

                    @if (ViewBag.Mensaje != null)
                    {
                        <div class="alert alert-success">
                            @ViewBag.Mensaje
                        </div>
                    }

                    <form asp-action="Crear"
                          method="post"
                          enctype="multipart/form-data">

                        <div class="mb-4">

                            <label class="form-label">
                                Nombre del Operador
                            </label>

                            <input asp-for="NombreOperador"
                                   class="form-control form-control-lg" />

                        </div>

                        <div class="mb-4">

                            <label class="form-label">
                                Nombre o Código de la Máquina
                            </label>

                            <input asp-for="NombreMaquina"
                                   class="form-control form-control-lg" />

                        </div>

                        <div class="mb-4">

                            <label class="form-label">
                                Tipo de Maquinaria
                            </label>

                            <select asp-for="TipoMaquina"
                                    class="form-select form-select-lg">

                                <option value="">Seleccione</option>

                                <option>Motoniveladora</option>
                                <option>Bulldozer</option>
                                <option>Retroexcavadora</option>
                                <option>Excavadora</option>
                                <option>Vibrocompactador</option>
                                <option>Cargador</option>

                            </select>

                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-4">

                                <label class="form-label">
                                    Horómetro Inicial
                                </label>

                                <input asp-for="HorometroInicial"
                                       id="horometroInicial"
                                       class="form-control form-control-lg"
                                       readonly />

                            </div>

                            <div class="col-md-6 mb-4">

                                <label class="form-label">
                                    Horómetro Final
                                </label>

                                <input asp-for="HorometroFinal"
                                       id="horometroFinal"
                                       class="form-control form-control-lg"
                                       readonly />

                            </div>


                        </div>

                        <hr />

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label class="form-label fw-bold">
                                    Foto Horómetro Inicial
                                </label>

                                <input type="file"
                                       id="fotoInicial"
                                       name="fotoInicial"
                                       class="form-control"
                                       accept="image/*" />

                            </div>

                            <div class="col-md-6 mb-3">

                                <label class="form-label fw-bold">
                                    Foto Horómetro Final
                                </label>

                                <input type="file"
                                       id="fotoFinal"
                                       name="fotoFinal"
                                       class="form-control"
                                       accept="image/*" />

                            </div>

                        </div>

                        <div class="mb-4">

                            <label class="form-label">
                                Observaciones Operacionales
                            </label>

                            <textarea asp-for="Observaciones"
                                      class="form-control"
                                      rows="4"></textarea>

                        </div>


                        <button type="submit"
                                class="btn btn-industrial w-100">

                            ENVIAR REPORTE OPERACIONAL

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>
    <script>

        document
        .getElementById("fotoInicial")
        .addEventListener("change", async function () {

            let archivo = this.files[0];

            if (!archivo)
                return;

            let formData = new FormData();

            formData.append("imagen", archivo);

            let respuesta = await fetch('/Reporte/LeerHorometro',
            {
                method: 'POST',
                body: formData
            });

            let datos = await respuesta.json();

            if (datos.exito)
            {
                document
                    .getElementById("horometroInicial")
                    .value = datos.valor;
            }
        });

        document
        .getElementById("fotoFinal")
        .addEventListener("change", async function () {

            let archivo = this.files[0];

            if (!archivo)
                return;

            let formData = new FormData();

            formData.append("imagen", archivo);

            let respuesta = await fetch('/Reporte/LeerHorometro',
            {
                method: 'POST',
                body: formData
            });

            let datos = await respuesta.json();

            if (datos.exito)
            {
                document
                    .getElementById("horometroFinal")
                    .value = datos.valor;
            }
        });

    </script>

</div>