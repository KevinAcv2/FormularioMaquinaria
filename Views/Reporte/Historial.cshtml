@model IEnumerable<FormularioMaquinaria.Models.ReporteMaquinaria>

@{
    ViewData["Title"] = "Historial de Reportes";
}

<link rel="stylesheet"
      href="~/css/historial.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/evaluacion-modal.css"
      asp-append-version="true" />


<div class="container-fluid">


    <div class="historial-header mb-4">

        <div>

            <h1 class="titulo-reporte">
                📝 Historial de Reportes
            </h1>

            <p class="subtitulo-reporte">
                Consulta todos los reportes registrados en el sistema.
            </p>

        </div>

        <div class="acciones-reporte">

            <button type="button"
                    class="btn btn-outline-primary btn-exportar"
                    onclick="imprimirHistorial()">

                <i class="fa-solid fa-print"></i>
                Imprimir

            </button>

            <a asp-action="ExportarExcel"
               class="btn btn-success btn-exportar">

                <i class="fa-solid fa-file-excel"></i>

                Exportar Excel

            </a>
            <a asp-action="ExportarPdfHistorial"
               class="btn btn-danger btn-exportar">

                <i class="fa-solid fa-file-pdf"></i>

                Exportar PDF

            </a>

        </div>

    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <form asp-action="Historial" method="get">

            <div class="row align-items-end mb-4">

                    <!-- FILTROS -->
                    <div class="col-lg-8">

                        <div class="row g-2">

                            <div class="col-3">
                                <input type="text"
                                    name="buscar"
                                    class="form-control"
                                    placeholder="🔍 Buscar...."
                                    value="@ViewBag.Buscar">
                            </div>

                            <div class="col-3">
                                <input type="date"
                                    naem="desde"
                                    class="form-control"
                                    value="@ViewBag.Desde">
                            </div>

                            <div class="col-3">
                                <input type="date"
                                       class="form-control">
                            </div>

                            <div class="col-3">
                                <select name="estado" class="form-select">

                                    <option value="">Estado</option>

                                    <option value="Operativa"
                                            selected="@(ViewBag.Estado == "Operativa")">
                                        Operativa
                                    </option>

                                    <option value="No Operativa"
                                            selected="@(ViewBag.Estado == "No Operativa")">
                                        No Operativa
                                    </option>

                                </select>
                            </div>

                        </div>

                    </div>

                <!-- BOTONES -->
                <div class="col-lg-4">
                        
                    <div class="d-flex justify-content-end gap-2">

                            <button type="submit"
                                    class="btn btn-primary btn-toolbar-custom">
                                <i class="fa-solid fa-magnifying-glass"></i>
                                Buscar
                            </button>

                        <a asp-action="Historial"
                           class="btn btn-secondary btn-toolbar-custom">
                            <i class="fa-solid fa-rotate"></i>
                            Limpiar
                        </a>

                        <a asp-action="Crear"
                           class="btn btn-success btn-toolbar-custom">
                            <i class="fa-solid fa-plus"></i>
                            Nuevo
                        </a>

                    </div>

                </div>

            </div>

            <table class="table table-hover align-middle">

                <thead>

                    <tr>

                        <th>Fecha</th>
                        <th>Operador</th>
                        <th>Máquina</th>
                        <th>Horas</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {

                        <tr>

                            <td>
                                @item.Fecha.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @item.NombreOperador
                            </td>

                            <td>
                                @item.NombreMaquina
                            </td>

                            <td>
                                @item.HorasTrabajadas
                            </td>

                            <td>

                                @if (item.EstadoMaquina == 1)
                                {
                                    <span class="badge bg-success">
                                        Operativa
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        No Operativa
                                    </span>
                                }

                            </td>

                                <td class="text-center">

                                    <!-- VER REPORTE -->
                                    <a asp-action="Ver"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-primary">

                                        <i class="fa-solid fa-eye"></i>

                                    </a>

                                    <!-- EVALUAR -->
                                    <button type="button"
                                            class="btn btn-sm btn-warning btnEvaluar"
                                            data-id="@item.Id"
                                            data-operador="@item.NombreOperador"
                                            data-maquina="@item.NombreMaquina">

                                        <i class="fa-solid fa-clipboard-check"></i>

                                    </button>

                                    <!-- ELIMINAR -->
                                    <button type="button"
                                            class="btn btn-sm btn-danger">

                                        <i class="fa-solid fa-trash"></i>

                                    </button>

                                </td>

                        </tr>

                    }

                </tbody>

            </table>

            </form>

        </div>

    </div>
    <!-- MODAL EVALUACIÓN -->

    <div class="modal fade"
         id="modalEvaluacion"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title fw-bold">

                        <i class="fa-solid fa-star text-warning me-2"></i>

                        Evaluación del Operador

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">

                    <input type="hidden" id="ReporteId" />

                    <div class="alert alert-light border mb-4">

                        <div class="row">

                            <div class="col-md-6">

                                <strong>Operador</strong>

                                <p id="lblOperador" class="mb-0"></p>

                            </div>

                            <div class="col-md-6">

                                <strong>Máquina</strong>

                                <p id="lblMaquina" class="mb-0"></p>

                            </div>

                        </div>

                    </div>

                    <div class="evaluacion-item">

                        <label>Horario</label>

                        <div class="rating" data-name="Horario"></div>

                    </div>

                    <div class="evaluacion-item">

                        <label>Manejo de Maquinaria</label>

                        <div class="rating" data-name="ManejoMaquinaria"></div>

                    </div>

                    <div class="evaluacion-item">

                        <label>Cuidado del Equipo</label>

                        <div class="rating" data-name="CuidadoEquipo"></div>

                    </div>

                    <div class="evaluacion-item">

                        <label>Seguridad Industrial</label>

                        <div class="rating" data-name="SeguridadIndustrial"></div>

                    </div>

                    <div class="evaluacion-item">

                        <label>Productividad</label>

                        <div class="rating" data-name="Productividad"></div>

                    </div>

                    <div class="evaluacion-item">

                        <label>Reporte de Novedades</label>

                        <div class="rating" data-name="ReporteNovedades"></div>

                    </div>

                    <div class="mt-4">

                        <label class="fw-bold">

                            Observaciones

                        </label>

                        <textarea id="ObservacionSupervisor"
                                  class="form-control"
                                  rows="4"></textarea>

                    </div>

                </div>

                <div class="modal-footer">

                    <button class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Cancelar

                    </button>

                    <button id="btnGuardarEvaluacion" class="btn btn-success">
                        <i class="fa-solid fa-floppy-disk me-2"></i>

                        Guardar Evaluación

                    </button>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts{
    <script src="~/js/Historial.js" asp-append-version="true"></script>
}

