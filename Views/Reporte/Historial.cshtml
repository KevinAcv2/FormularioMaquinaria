@model IEnumerable<FormularioMaquinaria.Models.ReporteMaquinaria>

@{
    ViewData["Title"] = "Historial de Reportes";
}

<link rel="stylesheet"
      href="~/css/historial.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/evaluacion-modal.css"
      asp-append-version="true" />

<div class="container-fluid">

    <!-- ===================================================== -->
    <!-- ENCABEZADO -->
    <!-- ===================================================== -->

    <div id="reporteHistorial">

        <div class="historial-header mb-4">

            <div>
                <h1 class="titulo-reporte">
                    📝 Historial de Reportes
                </h1>

                <p class="subtitulo-reporte">
                    Consulta todos los reportes registrados en el sistema.
                </p>
            </div>

            <!-- EXPORTACIONES -->

            <div class="acciones-reporte no-print">

                <button type="button"
                        class="btn btn-outline-primary btn-exportar"
                        onclick="imprimirHistorial()">

                    <i class="fa-solid fa-print"></i>
                    Imprimir

                </button>

                <a asp-action="ExportarExcel"
                   class="btn btn-success btn-exportar">

                    <i class="fa-solid fa-file-excel"></i>
                    Exportar Excel

                </a>

                <a asp-action="ExportarPdfHistorial"
                   class="btn btn-danger btn-exportar">

                    <i class="fa-solid fa-file-pdf"></i>
                    Exportar PDF

                </a>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- TARJETA PRINCIPAL -->
        <!-- ===================================================== -->

        <div class="card shadow-sm border-0">

            <div class="card-body">

                <!-- ================================================= -->
                <!-- FILTROS -->
                <!-- ================================================= -->

                <form asp-action="Historial"
                      method="get">

                    <div class="historial-toolbar no-print">

                        <!-- BUSCAR -->

                        <div class="historial-search">

                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="fa-solid fa-magnifying-glass"></i>
                                </span>

                                <input type="text"
                                       name="buscar"
                                       class="form-control"
                                       placeholder="Buscar operador o maquinaria..."
                                       value="@ViewBag.Buscar" />

                            </div>

                        </div>


                        <!-- DESDE -->

                        <div class="historial-filtro">

                            <input type="date"
                                   name="desde"
                                   class="form-control"
                                   value="@ViewBag.Desde" />

                        </div>


                        <!-- HASTA -->

                        <div class="historial-filtro">

                            <input type="date"
                                   name="hasta"
                                   class="form-control"
                                   value="@ViewBag.Hasta" />

                        </div>


                        <!-- ESTADO -->

                        <div class="historial-filtro">

                            <select name="estado"
                                    class="form-select">

                                <option value="">
                                    Estado
                                </option>

                                <option value="Operativa"
                                        selected="@(ViewBag.Estado == "Operativa")">

                                    Operativa

                                </option>

                                <option value="No Operativa"
                                        selected="@(ViewBag.Estado == "No Operativa")">

                                    No Operativa

                                </option>

                            </select>

                        </div>


                        <!-- ACCIONES -->

                        <div class="historial-acciones">

                            <button type="submit"
                                    class="btn btn-primary btn-toolbar-custom">

                                <i class="fa-solid fa-magnifying-glass"></i>
                                Buscar

                            </button>

                            <a asp-action="Historial"
                               class="btn btn-secondary btn-toolbar-custom">

                                <i class="fa-solid fa-rotate"></i>
                                Limpiar

                            </a>

                            <a asp-action="Crear"
                               class="btn btn-success btn-toolbar-custom">

                                <i class="fa-solid fa-plus"></i>
                                Nuevo

                            </a>

                        </div>

                    </div>

                </form>


                <!-- ================================================= -->
                <!-- TABLA -->
                <!-- ================================================= -->

                <div class="historial-table-container">

                    <table class="table table-hover align-middle">

                        <thead>

                            <tr>

                                <th>
                                    Fecha
                                </th>

                                <th>
                                    Operador
                                </th>

                                <th>
                                    Máquina
                                </th>

                                <th>
                                    Horas
                                </th>

                                <th>
                                    Estado
                                </th>

                                <th class="text-center no-print">
                                    Acciones
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @if (Model != null && Model.Any())
                            {

                                @foreach (var item in Model)
                                {

                                    <tr>

                                        <!-- FECHA -->

                                        <td>
                                            @item.Fecha.ToString("dd/MM/yyyy")
                                        </td>


                                        <!-- OPERADOR -->

                                        <td>
                                            @item.NombreOperador
                                        </td>


                                        <!-- MÁQUINA -->

                                        <td>
                                            @item.NombreMaquina
                                        </td>


                                        <!-- HORAS -->

                                        <td>
                                            @item.HorasTrabajadas
                                        </td>


                                        <!-- ESTADO -->

                                        <td>

                                            @if (item.EstadoMaquina == 1)
                                            {

                                                <span class="badge bg-success">
                                                    Operativa
                                                </span>

                                            }
                                            else
                                            {

                                                <span class="badge bg-danger">
                                                    No Operativa
                                                </span>

                                            }

                                        </td>


                                        <!-- ACCIONES -->

                                        <td class="text-center no-print">

                                            <!-- VER -->

                                            <a asp-action="Ver"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-primary btnVerReporte"
                                               title="Ver reporte">

                                                <i class="fa-solid fa-eye"></i>

                                            </a>


                                            <!-- EVALUAR -->

                                            <button type="button"
                                                    class="btn btn-sm btn-warning btnEvaluar"
                                                    data-id="@item.Id"
                                                    data-operador="@item.NombreOperador"
                                                    data-maquina="@item.NombreMaquina"
                                                    title="Evaluar">

                                                <i class="fa-solid fa-clipboard-check"></i>

                                            </button>


                                            <!-- ELIMINAR -->

                                            <button type="button"
                                                    class="btn btn-sm btn-danger btnEliminar"
                                                    data-id="@item.Id"
                                                    title="Eliminar">

                                                <i class="fa-solid fa-trash"></i>

                                            </button>

                                        </td>

                                    </tr>

                                }

                            }
                            else
                            {

                                <tr>

                                    <td colspan="6"
                                        class="text-center py-4">

                                        <i class="fa-solid fa-inbox fa-2x text-muted mb-2"></i>

                                        <p class="mb-0 text-muted">
                                            No se encontraron reportes.
                                        </p>

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- MODAL EVALUACIÓN -->
    <!-- ===================================================== -->

    <div class="modal fade"
         id="modalEvaluacion"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content">

                <!-- HEADER -->

                <div class="modal-header">

                    <h5 class="modal-title fw-bold">

                        <i class="fa-solid fa-star text-warning me-2"></i>

                        Evaluación del Operador

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <!-- BODY -->

                <div class="modal-body">

                    <input type="hidden"
                           id="ReporteId" />


                    <!-- INFORMACIÓN DEL REPORTE -->

                    <div class="alert alert-light border mb-4">

                        <div class="row">

                            <div class="col-md-6">

                                <strong>
                                    Operador
                                </strong>

                                <p id="lblOperador"
                                   class="mb-0">
                                </p>

                            </div>

                            <div class="col-md-6">

                                <strong>
                                    Máquina
                                </strong>

                                <p id="lblMaquina"
                                   class="mb-0">
                                </p>

                            </div>

                        </div>

                    </div>


                    <!-- HORARIO -->

                    <div class="evaluacion-item">

                        <label>
                            Horario
                        </label>

                        <div class="rating"
                             data-name="Horario">
                        </div>

                    </div>


                    <!-- MANEJO -->

                    <div class="evaluacion-item">

                        <label>
                            Manejo de Maquinaria
                        </label>

                        <div class="rating"
                             data-name="ManejoMaquinaria">
                        </div>

                    </div>


                    <!-- CUIDADO -->

                    <div class="evaluacion-item">

                        <label>
                            Cuidado del Equipo
                        </label>

                        <div class="rating"
                             data-name="CuidadoEquipo">
                        </div>

                    </div>


                    <!-- SEGURIDAD -->

                    <div class="evaluacion-item">

                        <label>
                            Seguridad Industrial
                        </label>

                        <div class="rating"
                             data-name="SeguridadIndustrial">
                        </div>

                    </div>


                    <!-- PRODUCTIVIDAD -->

                    <div class="evaluacion-item">

                        <label>
                            Productividad
                        </label>

                        <div class="rating"
                             data-name="Productividad">
                        </div>

                    </div>


                    <!-- NOVEDADES -->

                    <div class="evaluacion-item">

                        <label>
                            Reporte de Novedades
                        </label>

                        <div class="rating"
                             data-name="ReporteNovedades">
                        </div>

                    </div>


                    <!-- OBSERVACIONES -->

                    <div class="mt-4">

                        <label class="fw-bold">
                            Observaciones
                        </label>

                        <textarea id="ObservacionSupervisor"
                                  class="form-control"
                                  rows="4"></textarea>

                    </div>

                </div>


                <!-- FOOTER -->

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Cancelar

                    </button>

                    <button type="button"
                            id="btnGuardarEvaluacion"
                            class="btn btn-success">

                        <i class="fa-solid fa-floppy-disk me-2"></i>

                        Guardar Evaluación

                    </button>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script src="~/js/Historial.js"
            asp-append-version="true">
    </script>

}