@model IEnumerable<FormularioMaquinaria.Models.Operador>

@{
    ViewData["Title"] = "Gestión de Operadores";
}

<link rel="stylesheet"
      href="~/css/operadores.css"
      asp-append-version="true" />

<div class="container-fluid">

    <div id="reporteOperadores">

        <!-- ==========================================
             ENCABEZADO
        =========================================== -->
        <div class="historial-header mb-4 d-flex justify-content-between align-items-center">

            <div>
                <h1 class="titulo-reporte">
                    👷 Gestión de Operadores
                </h1>

                <p class="subtitulo-reporte text-muted">
                    Administración de operadores autorizados.
                </p>
            </div>

            <!-- EXPORTACIONES -->
            <div class="acciones-reporte no-print">

                <a asp-action="ExportarExcel"
                   class="btn btn-success btn-exp">
                    <i class="fa-solid fa-file-excel me-1"></i>
                    <span>Exportar Excel</span>
                </a>

                <a asp-action="ExportarPdf"
                   class="btn btn-danger btn-exp ms-1">
                    <i class="fa-solid fa-file-pdf me-1"></i>
                    <span>Exportar PDF</span>
                </a>

            </div>

        </div>


        <!-- ==========================================
             TOTAL OPERADORES
        =========================================== -->
        <div class="row mb-3">

            <div class="col-md-4">

                <div class="card-custom text-center p-3 shadow-sm rounded">

                    <h5 class="text-secondary">Total Operadores</h5>

                    <h2 class="fw-bold mb-0">
                        @Model.Count()
                    </h2>

                </div>

            </div>

        </div>

        <!-- ==========================================
             TARJETA PRINCIPAL
        =========================================== -->
        <div class="card shadow-sm border-0 operadores-card">

            <div class="card-body">

                <!-- ==================================
                     BARRA DE FILTROS Y ACCIONES
                     (todo en una sola fila, sin etiquetas)
                =================================== -->
                <div class="operadores-toolbar no-print mb-4">

                    <!-- BUSCAR POR NOMBRE -->
                    <div class="operadores-search">
                        <input type="text"
                               id="buscarOperador"
                               class="form-control"
                               placeholder="Buscar operador..."
                               autocomplete="off" />
                    </div>

                    <!-- FRENTE OPERACIONAL -->
                    <div class="operadores-filtro">
                        <select id="filtroFrente" class="form-select">
                            <option value="">Todos los frentes</option>
                            @if (ViewBag.Frentes != null)
                            {
                                foreach (var frente in ViewBag.Frentes)
                                {
                                    <option value="@frente.Id">@frente.Nombre</option>
                                }
                            }
                        </select>
                    </div>

                    <!-- ACCIONES -->
                    <div class="operadores-acciones">

                        <button type="button"
                                id="btnResetFiltros"
                                class="btn btn-secondary btn-icon-square"
                                title="Limpiar filtros">
                            <i class="fa-solid fa-rotate-right"></i>
                        </button>

                        <button type="button"
                                class="btn btn-success btn-toolbar-custom"
                                data-bs-toggle="modal"
                                data-bs-target="#modalNuevoOperador">
                            <i class="fa-solid fa-plus me-1"></i>
                            <span>Nuevo</span>
                        </button>

                        <button type="button"
                                class="btn btn-primary btn-toolbar-custom"
                                data-bs-toggle="modal"
                                data-bs-target="#modalFrentes">
                            <i class="fa-solid fa-map-location-dot me-1"></i>
                            <span>Frentes</span>
                        </button>

                    </div>

                </div>

                <!-- ==================================
                     TABLA DE OPERADORES
                =================================== -->
                <div class="operadores-table-container table-responsive">

                    <table class="table table-hover align-middle mb-0" id="tablaOperadores">

                        <thead class="table-dark-custom">
                            <tr>
                                <th>Nombre</th>
                                <th>Máquina</th>
                                <th>Frente Operacional</th>
                                <th class="no-print text-center">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <tr class="filaOperador"
                                        data-nombre="@item.Nombre"
                                        data-maquina="@item.MaquinaId"
                                        data-frente="@item.FrenteOperacionalId">

                                        <td>@item.Nombre</td>
                                        <td>@(item.Maquina != null ? item.Maquina.Nombre : "Sin asignar")</td>
                                        <td>@(item.FrenteOperacional != null ? item.FrenteOperacional.Nombre : "Sin asignar")</td>

                                        <td class="text-center no-print">
                                            <button type="button"
                                                    class="btn btn-warning btn-sm btnEditar"
                                                    data-id="@item.Id"
                                                    data-nombre="@item.Nombre"
                                                    data-maquina="@item.MaquinaId"
                                                    data-frenteid="@item.FrenteOperacionalId"
                                                    title="Editar">
                                                <i class="fa-solid fa-pencil"></i>
                                            </button>

                                            <button type="button"
                                                    class="btn btn-danger btn-sm btnEliminar"
                                                    data-id="@item.Id"
                                                    title="Eliminar">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr id="trSinResultados">
                                    <td colspan="4" class="text-center text-muted py-3">
                                        No se encontraron registros de operadores.
                                    </td>
                                </tr>
                            }

                            <!-- FILA "SIN RESULTADOS" PARA EL FILTRADO EN VIVO -->
                            <tr id="filaSinResultadosFiltro" style="display:none;">
                                <td colspan="4" class="text-center text-muted py-3">
                                    No hay operadores que coincidan con el filtro.
                                </td>
                            </tr>
                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- ==================================================
     MODAL EDITAR OPERADOR
=================================================== -->
<div class="modal fade"
     id="modalEditarOperador"
     tabindex="-1"
     aria-labelledby="modalEditarOperadorLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header">

                <h5 class="modal-title fw-bold" id="modalEditarOperadorLabel">
                    <i class="fa-solid fa-user-pen text-warning me-2"></i>
                    Editar Operador
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                </button>

            </div>

            <!-- FORMULARIO -->
            <form id="formEditarOperador">

                <div class="modal-body">

                    <input type="hidden" id="EditarId" name="Id" />

                    <!-- NOMBRE -->
                    <div class="mb-3">
                        <label for="EditarNombre" class="form-label fw-bold">Nombre</label>
                        <input type="text"
                               id="EditarNombre"
                               name="Nombre"
                               class="form-control"
                               required />
                    </div>

                    <!-- MÁQUINA -->
                    <div class="mb-3">
                        <label for="EditarMaquina" class="form-label fw-bold">Máquina</label>
                        <select id="EditarMaquina" name="MaquinaId" class="form-select">
                            <option value="">Seleccione una máquina</option>
                            @if (ViewBag.Maquinas != null)
                            {
                                foreach (var maquina in ViewBag.Maquinas)
                                {
                                    <option value="@maquina.Value">@maquina.Text</option>
                                }
                            }
                        </select>
                    </div>

                    <!-- FRENTE -->
                    <div class="mb-3">
                        <label for="EditarFrente" class="form-label fw-bold">Frente Operacional</label>
                        <select id="EditarFrente" name="FrenteOperacionalId" class="form-select">
                            <option value="">Seleccione un frente</option>
                            @if (ViewBag.Frentes != null)
                            {
                                foreach (var frente in ViewBag.Frentes)
                                {
                                    <option value="@frente.Id">@frente.Nombre</option>
                                }
                            }
                        </select>
                    </div>

                </div>

                <!-- FOOTER -->
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-success">
                        <i class="fa-solid fa-floppy-disk me-2"></i>
                        Guardar Cambios
                    </button>
                </div>

            </form>

        </div>

    </div>

</div>


<!-- ==================================================
     MODAL NUEVO OPERADOR
=================================================== -->
<div class="modal fade"
     id="modalNuevoOperador"
     tabindex="-1"
     aria-labelledby="modalNuevoOperadorLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header">

                <h5 class="modal-title fw-bold" id="modalNuevoOperadorLabel">
                    <i class="fa-solid fa-user-plus text-success me-2"></i>
                    Nuevo Operador
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                </button>

            </div>

            <!-- FORMULARIO -->
            <form id="formNuevoOperador">

                <div class="modal-body">

                    <!-- NOMBRE -->
                    <div class="mb-3">
                        <label for="NuevoNombre" class="form-label fw-bold">Nombre</label>
                        <input type="text"
                               id="NuevoNombre"
                               name="Nombre"
                               class="form-control"
                               required />
                    </div>

                    <!-- MÁQUINA -->
                    <div class="mb-3">
                        <label for="NuevaMaquina" class="form-label fw-bold">Máquina</label>
                        <select id="NuevaMaquina" name="MaquinaId" class="form-select">
                            <option value="">Seleccione una máquina</option>
                            @if (ViewBag.Maquinas != null)
                            {
                                foreach (var maquina in ViewBag.Maquinas)
                                {
                                    <option value="@maquina.Value">@maquina.Text</option>
                                }
                            }
                        </select>
                    </div>

                    <!-- FRENTE -->
                    <div class="mb-3">
                        <label for="NuevoFrente" class="form-label fw-bold">Frente Operacional</label>
                        <select id="NuevoFrente" name="FrenteOperacionalId" class="form-select" required>
                            <option value="">Seleccione un frente</option>
                            @if (ViewBag.Frentes != null)
                            {
                                foreach (var frente in ViewBag.Frentes)
                                {
                                    <option value="@frente.Id">@frente.Nombre</option>
                                }
                            }
                        </select>
                    </div>

                </div>

                <!-- FOOTER -->
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-success">
                        <i class="fa-solid fa-floppy-disk me-2"></i>
                        Guardar Operador
                    </button>
                </div>

            </form>

        </div>

    </div>

</div>


<!-- ==================================================
     MODAL GESTIÓN DE FRENTES
=================================================== -->
<div class="modal fade"
     id="modalFrentes"
     tabindex="-1"
     aria-labelledby="modalFrentesLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header bg-success text-white">

                <h5 class="modal-title" id="modalFrentesLabel">
                    <i class="fa-solid fa-map-location-dot me-2"></i>
                    Gestión de Frentes Operacionales
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                </button>

            </div>

            <!-- BODY -->
            <div class="modal-body">

                <!-- AGREGAR FRENTE -->
                <form asp-controller="FrenteOperacional"
                      asp-action="Crear"
                      method="post"
                      class="row g-2 mb-4">

                    <div class="col-md-9">
                        <input type="text"
                               name="Nombre"
                               class="form-control"
                               placeholder="Nombre del frente"
                               required />
                    </div>

                    <div class="col-md-3">
                        <button type="submit" class="btn btn-success w-100">
                            <i class="fa-solid fa-plus me-1"></i>
                            Agregar
                        </button>
                    </div>

                </form>

                <hr />

                <!-- TABLA DE FRENTES -->
                <div class="frentes-table-container table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Nombre</th>
                                <th style="width: 120px;" class="text-center">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (ViewBag.Frentes != null)
                            {
                                foreach (var frente in ViewBag.Frentes)
                                {
                                    <tr>
                                        <td>@frente.Id</td>
                                        <td>@frente.Nombre</td>
                                        <td class="text-center">
                                            <a asp-controller="FrenteOperacional"
                                               asp-action="Eliminar"
                                               asp-route-id="@frente.Id"
                                               class="btn btn-sm btn-danger btnEliminarFrente"
                                               data-id="@frente.Id"
                                               data-nombre="@frente.Nombre"
                                               title="Eliminar">
                                                <i class="fa-solid fa-trash"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <script src="~/js/Operadores.js" asp-append-version="true"></script>
}
