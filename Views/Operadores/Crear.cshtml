@model FormularioMaquinaria.Models.Operador

<div class="container mt-4">

    <h2>Nuevo Operador</h2>

    <form asp-action="Crear" method="post">

        <div class="mb-3">

            <label>Nombre</label>

            <input asp-for="Nombre"
                   class="form-control" />

        </div>

        <div class="mb-3">

            <label>Máquina Asignada</label>

            <select asp-for="MaquinaId"
                    class="form-select">

                <option value="">
                    Seleccione una máquina
                </option>

                @foreach (var maquina in ViewBag.Maquinas)
                {
                    <option value="@maquina.Id">
                        @maquina.Nombre
                    </option>
                }

            </select>

        </div>

        <button type="submit"
                class="btn btn-primary">

            Guardar

        </button>

    </form>

</div>