@model IEnumerable<FormularioMaquinaria.Models.Maquina>

@{
    ViewData["Title"] = "Gestión de Maquinaria";
}

<link rel="stylesheet"
      href="~/css/maquinaria.css"
      asp-append-version="true" />


<div class="container-fluid">

    <!-- ================================================= -->
    <!-- CONTENIDO PRINCIPAL -->
    <!-- ================================================= -->

    <div id="reporteMaquinaria">

        <!-- ================================================= -->
        <!-- ENCABEZADO -->
        <!-- ================================================= -->

        <div class="historial-header">

            <div>

                <h1 class="titulo-reporte">
                    🚜 Gestión de Maquinaria
                </h1>

                <p class="subtitulo-reporte">
                    Administración de maquinaria registrada.
                </p>

            </div>


            <!-- EXPORTACIONES -->

            <div class="acciones-reporte no-print">

                <a asp-action="ExportarExcel"
                   class="btn btn-success btn-exp">

                    <i class="fa-solid fa-file-excel"></i>

                    <span>
                        Exportar Excel
                    </span>

                </a>


                <a asp-action="ExportarPdf"
                   class="btn btn-danger btn-exp">

                    <i class="fa-solid fa-file-pdf"></i>

                    <span>
                        Exportar PDF
                    </span>

                </a>

            </div>

        </div>


        <!-- ================================================= -->
        <!-- TOTAL MAQUINARIA -->
        <!-- ================================================= -->

        <div class="row mb-3">

            <div class="col-md-4">

                <div class="card-custom text-center">

                    <h5>
                        Total Maquinaria
                    </h5>

                    <h2>
                        @Model.Count()
                    </h2>

                </div>

            </div>

        </div>


        <!-- ================================================= -->
        <!-- TARJETA PRINCIPAL -->
        <!-- ================================================= -->

        <div class="maquinaria-card card shadow-sm border-0">

            <div class="card-body">


                <!-- ================================================= -->
                <!-- TOOLBAR -->
                <!-- ================================================= -->

                <form asp-action="Index"
                      method="get">

                    <div class="maquinaria-toolbar no-print">


                        <!-- ================================================= -->
                        <!-- BUSCADOR -->
                        <!-- ================================================= -->

                        <div class="maquinaria-search">

                            <div class="input-group">

                                <span class="input-group-text">

                                    <i class="fa-solid fa-magnifying-glass"></i>

                                </span>

                                <input type="text"
                                       name="buscar"
                                       class="form-control"
                                       placeholder="Buscar maquinaria..."
                                       value="@ViewBag.Buscar" />

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- FILTRO ESTADO -->
                        <!-- ================================================= -->

                        <div class="maquinaria-filtro">

                            <select name="estado"
                                    class="form-select">

                                <option value="">
                                    Estado
                                </option>

                                <option value="1"
                                        selected="@(ViewBag.Estado?.ToString() == "1" ? "selected" : null)">
                                    OPERATIVA
                                </option>

                                <option value="0"
                                        selected="@(ViewBag.Estado?.ToString() == "0" ? "selected" : null)">
                                    NO OPERATIVA
                                </option>

                            </select>

                        </div>


                        <!-- ================================================= -->
                        <!-- ACCIONES -->
                        <!-- ================================================= -->

                        <div class="maquinaria-acciones">


                            <!-- BUSCAR -->

                            <button type="submit"
                                    class="btn btn-primary btn-toolbar-custom">

                                <i class="fa-solid fa-magnifying-glass"></i>

                                <span>
                                    Buscar
                                </span>

                            </button>


                            <!-- LIMPIAR -->

                            <a asp-action="Index"
                               class="btn btn-secondary btn-toolbar-custom">

                                <i class="fa-solid fa-rotate"></i>

                                <span>
                                    Limpiar
                                </span>

                            </a>


                            <!-- NUEVA -->

                            <button type="button"
                                    class="btn btn-success btn-toolbar-custom"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modalNuevaMaquina">

                                <i class="fa-solid fa-plus"></i>

                                <span>
                                    Nueva
                                </span>

                            </button>

                        </div>

                    </div>

                </form>


                <!-- ================================================= -->
                <!-- TABLA -->
                <!-- ================================================= -->

                <div class="maquinaria-table-container">

                    <table class="table table-hover align-middle">


                        <!-- ENCABEZADO -->

                        <thead>

                            <tr>

                                <th>
                                    ID
                                </th>

                                <th>
                                    Máquina
                                </th>

                                <th>
                                    Estado
                                </th>

                                <th class="no-print text-center">
                                    Acciones
                                </th>

                            </tr>

                        </thead>


                        <!-- CUERPO -->

                        <tbody>

                            @foreach (var item in Model)
                            {

                                <tr>


                                    <!-- ================================================= -->
                                    <!-- ID -->
                                    <!-- ================================================= -->

                                    <td>
                                        @item.Id
                                    </td>


                                    <!-- ================================================= -->
                                    <!-- MÁQUINA -->
                                    <!-- ================================================= -->

                                    <td>
                                        @item.Nombre
                                    </td>


                                    <!-- ================================================= -->
                                    <!-- ESTADO -->
                                    <!-- ================================================= -->

                                    <td>

                                        @if (item.Estado == "1")
                                        {

                                            <span class="badge bg-success">
                                                OPERATIVA
                                            </span>

                                        }
                                        else
                                        {

                                            <span class="badge bg-danger">
                                                NO OPERATIVA
                                            </span>

                                        }

                                    </td>


                                    <!-- ================================================= -->
                                    <!-- ACCIONES -->
                                    <!-- ================================================= -->

                                    <td class="text-center no-print">


                                        <!-- EDITAR -->

                                        <button type="button"
                                                class="btn btn-warning btn-sm btnEditar"
                                                data-id="@item.Id"
                                                data-nombre="@item.Nombre"
                                                data-estado="@item.Estado"
                                                title="Editar">

                                            <i class="fa-solid fa-pencil"></i>

                                        </button>


                                        <!-- ELIMINAR -->

                                        <a href="#"
                                           class="btn btn-danger btn-sm btnEliminar"
                                           data-id="@item.Id"
                                           title="Eliminar">

                                            <i class="fa-solid fa-trash"></i>

                                        </a>

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>



<!-- ========================================================= -->
<!-- MODAL NUEVA MÁQUINA -->
<!-- ========================================================= -->

<div class="modal fade"
     id="modalNuevaMaquina"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">


            <!-- HEADER -->

            <div class="modal-header">

                <h5 class="modal-title fw-bold">

                    <i class="fa-solid fa-truck-monster text-success me-2"></i>

                    Nueva Máquina

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <!-- FORMULARIO -->

            <form id="formNuevaMaquina">

                <div class="modal-body">


                    <!-- NOMBRE -->

                    <div class="mb-3">

                        <label class="form-label fw-bold">

                            Nombre / Tipo Maquinaria

                        </label>

                        <input type="text"
                               id="NombreMaquina"
                               class="form-control"
                               placeholder="Ej: RetroExcavadora KAT120"
                               required />

                    </div>


                    <!-- ESTADO -->

                    <div class="mb-3">

                        <label class="form-label fw-bold">

                            Estado de la Máquina

                        </label>

                        <select id="EstadoMaquina"
                                class="form-select"
                                required>

                            <option value="">
                                Seleccione un estado
                            </option>

                            <option value="1">
                                OPERATIVA
                            </option>

                            <option value="0">
                                NO OPERATIVA
                            </option>

                        </select>

                    </div>

                </div>


                <!-- FOOTER -->

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Cancelar

                    </button>


                    <button type="submit"
                            class="btn btn-success">

                        <i class="fa-solid fa-floppy-disk me-2"></i>

                        Guardar Máquina

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>



<!-- ========================================================= -->
<!-- MODAL EDITAR MÁQUINA -->
<!-- ========================================================= -->

<div class="modal fade"
     id="modalEditarMaquina"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">


            <!-- HEADER -->

            <div class="modal-header">

                <h5 class="modal-title fw-bold">

                    <i class="fa-solid fa-pen-to-square text-warning me-2"></i>

                    Editar Máquina

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <!-- FORMULARIO -->

            <form id="formEditarMaquina">

                <input type="hidden"
                       id="EditarId" />


                <div class="modal-body">


                    <!-- NOMBRE -->

                    <div class="mb-3">

                        <label class="form-label fw-bold">

                            Nombre / Tipo Maquinaria

                        </label>

                        <input type="text"
                               id="EditarNombre"
                               class="form-control"
                               required />

                    </div>


                    <!-- ESTADO -->

                    <div class="mb-3">

                        <label class="form-label fw-bold">

                            Estado

                        </label>

                        <select id="EditarEstado"
                                class="form-select"
                                required>

                            <option value="1">
                                OPERATIVA
                            </option>

                            <option value="0">
                                NO OPERATIVA
                            </option>

                        </select>

                    </div>

                </div>


                <!-- FOOTER -->

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Cancelar

                    </button>

                    <button type="submit"
                            class="btn btn-warning">

                        <i class="fa-solid fa-floppy-disk me-2"></i>

                        Guardar Cambios

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    <script src="~/js/maquinaria.js"
            asp-append-version="true">
    </script>
}