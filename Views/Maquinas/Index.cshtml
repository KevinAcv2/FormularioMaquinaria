@model IEnumerable<FormularioMaquinaria.Models.Maquina>

@{
    ViewData["Title"] = "Gestión de Maquinaria";

    var volquetas = ViewBag.Volquetas as IEnumerable<FormularioMaquinaria.Models.Volqueta>
                     ?? Enumerable.Empty<FormularioMaquinaria.Models.Volqueta>();
}

<link rel="stylesheet"
      href="~/css/maquinaria.css"
      asp-append-version="true" />


<div class="container-fluid">

    <!-- ================================================= -->
    <!-- CONTENIDO PRINCIPAL -->
    <!-- ================================================= -->

    <div id="reporteMaquinaria">

        <!-- ================================================= -->
        <!-- ENCABEZADO -->
        <!-- ================================================= -->

        <div class="historial-header">

            <div>

                <h1 class="titulo-reporte">
                    ⚙️ Gestión de Equipos
                </h1>

                <p class="subtitulo-reporte">
                    Administración de equipos registrados.
                </p>

            </div>


            <!-- EXPORTACIONES -->

            <div class="acciones-reporte no-print">

                <a asp-action="ExportarExcel"
                   class="btn btn-success btn-exp">

                    <i class="fa-solid fa-file-excel"></i>

                    <span>
                        Exportar Excel
                    </span>

                </a>


                <a asp-action="ExportarPdf"
                   class="btn btn-danger btn-exp">

                    <i class="fa-solid fa-file-pdf"></i>

                    <span>
                        Exportar PDF
                    </span>

                </a>

            </div>

        </div>

        <!-- ================================================= -->
        <!-- TOTAL DE EQUIPOS -->
        <!-- ================================================= -->

        <div class="row mb-3 g-3">

            <div class="col-md-6">

                <div class="card-custom text-center">

                    <h5>
                        Total Maquinaria
                    </h5>

                    <h2>
                        @Model.Count()
                    </h2>

                </div>

            </div>

            <div class="col-md-6">

                <div class="card-custom text-center">

                    <h5>
                        Total Volquetas
                    </h5>

                    <h2>
                        @volquetas.Count()
                    </h2>

                </div>

            </div>

        </div>

        <div class="maquinaria-card card shadow-sm border-0">

            <div class="card-body">

                <!-- ================================================= -->
                <!-- ENCABEZADO DE LA TARJETA -->
                <!-- ================================================= -->

                <div class="d-flex justify-content-between align-items-center mb-3">

                    <div>
                        <h4 class="fw-bold mb-1">
                            🚜 Gestión de Máquinas
                        </h4>
                        <p class="text-muted mb-0">
                            Administración de máquinas registradas.
                        </p>
                    </div>

                    <button type="button"
                            class="btn btn-success"
                            id="btnNuevaMaquina"
                            data-bs-toggle="modal"
                            data-bs-target="#modalNuevaMaquina">

                        <i class="fa-solid fa-plus me-2"></i>
                        Nueva Máquina

                    </button>

                </div>

                <!-- ================================================= -->
                <!-- FILTROS DE MÁQUINAS -->
                <!-- ================================================= -->

                <div class="row g-2 align-items-end mb-3">

                    <div class="col-md-8">

                        <label class="form-label fw-bold">
                            Buscar por nombre
                        </label>

                        <input type="text"
                               id="buscarMaquina"
                               class="form-control"
                               placeholder="Ej: RetroExcavadora"
                               autocomplete="off" />

                    </div>

                    <div class="col-md-3">

                        <label class="form-label fw-bold">
                            Estado
                        </label>

                        <select id="estadoMaquina" class="form-select">
                            <option value="">Todas</option>
                            <option value="1">Operativas</option>
                            <option value="0">No operativas</option>
                        </select>

                    </div>

                    <div class="col-md-1">

                        <button type="button"
                                id="limpiarFiltrosMaquina"
                                class="btn btn-secondary w-100"
                                title="Limpiar filtros">
                            <i class="fa-solid fa-rotate-left"></i>
                        </button>

                    </div>

                </div>

                <!-- ================================================= -->
                <!-- TABLA -->
                <!-- ================================================= -->

                <div class="maquinaria-table-container">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Máquina</th>
                                <th>Estado</th>
                                <th class="no-print text-center">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr class="filaMaquina"
                                    data-nombre="@item.Nombre"
                                    data-estado="@item.Estado">

                                    <td>@item.Nombre</td>

                                    <td>
                                        @if (item.Estado == "1")
                                        {
                                            <span class="badge bg-success">OPERATIVA</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">NO OPERATIVA</span>
                                        }
                                    </td>

                                    <td class="text-center no-print">

                                        <button type="button"
                                                class="btn btn-warning btn-sm btnEditar"
                                                data-id="@item.Id"
                                                data-nombre="@item.Nombre"
                                                data-estado="@item.Estado"
                                                title="Editar">
                                            <i class="fa-solid fa-pencil"></i>
                                        </button>

                                        <a href="#"
                                           class="btn btn-danger btn-sm btnEliminar"
                                           data-id="@item.Id"
                                           title="Eliminar">
                                            <i class="fa-solid fa-trash"></i>
                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>

<!-- ========================================================= -->
<!-- SECCIÓN VOLQUETAS -->
<!-- ========================================================= -->

<div class="maquinaria-card card shadow-sm border-0 mt-4">

    <div class="card-body">

        <!-- ENCABEZADO -->

        <div class="d-flex justify-content-between align-items-center mb-3">

            <div>

                <h4 class="fw-bold mb-1">
                    🚛 Gestión de Volquetas
                </h4>

                <p class="text-muted mb-0">
                    Administración de volquetas propias y alquiladas.
                </p>

            </div>

            <button type="button"
                    class="btn btn-success"
                    id="btnNuevaVolqueta"
                    data-bs-toggle="modal"
                    data-bs-target="#modalNuevaVolqueta">

                <i class="fa-solid fa-plus me-2"></i>

                Nueva Volqueta

            </button>

        </div>


        <!-- TABLA -->
        <!-- ===================================================== -->
        <!-- FILTROS DE VOLQUETAS -->
        <!-- ===================================================== -->

        <div class="row g-2 align-items-end mb-3">

            <!-- BUSCAR POR PLACA -->

            <div class="col-md-5">

                <label class="form-label fw-bold">
                    Buscar por placa
                </label>

                <input type="text"
                       id="buscarVolqueta"
                       class="form-control"
                       placeholder="Ej: ABC123"
                       autocomplete="off" />

            </div>


            <!-- FILTRO ESTADO -->

            <div class="col-md-3">

                <label class="form-label fw-bold">
                    Estado
                </label>

                <select id="estadoVolqueta"
                        class="form-select">

                    <option value="">
                        Todas
                    </option>

                    <option value="1">
                        Activas
                    </option>

                    <option value="0">
                        Inactivas
                    </option>

                </select>

            </div>


            <!-- FILTRO PROPIEDAD -->

            <div class="col-md-3">

                <label class="form-label fw-bold">
                    Propiedad
                </label>

                <select id="propiedadVolqueta"
                        class="form-select">

                    <option value="">
                        Todas
                    </option>

                    <option value="PROPIA">
                        Propias
                    </option>

                    <option value="ALQUILADA">
                        Alquiladas
                    </option>

                </select>

            </div>


            <!-- LIMPIAR -->

            <div class="col-md-1">

                <button type="button"
                        id="limpiarFiltrosVolqueta"
                        class="btn btn-secondary w-100"
                        title="Limpiar filtros">

                    <i class="fa-solid fa-rotate-left"></i>

                </button>

            </div>

        </div>

        <div class="maquinaria-table-container">

            <table class="table table-hover align-middle">

                <thead>

                    <tr>

                        <th>
                            Placa
                        </th>

                        <th>
                            Propiedad
                        </th>

                        <th>
                            Empresa Propietaria
                        </th>

                        <th>
                            Estado
                        </th>

                        <th class="text-center no-print">
                            Acciones
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (!volquetas.Any())
                    {
                        <tr>

                            <td colspan="6"
                                class="text-center text-muted py-4">

                                <i class="fa-solid fa-truck-ramp-box fa-2x mb-2"></i>

                                <br />

                                No hay volquetas registradas.

                            </td>

                        </tr>
                    }
                    else
                    {
                        foreach (var volqueta in volquetas)
                        {
                            <tr class="filaVolqueta"
                                data-placa="@volqueta.Placa"
                                data-estado="@volqueta.Estado"
                                data-propiedad="@volqueta.Propiedad">


                                <!-- PLACA -->

                                <td>

                                    <strong>
                                        @volqueta.Placa
                                    </strong>

                                </td>

                                <!-- PROPIEDAD -->

                                <td>

                                    @if (volqueta.Propiedad == "PROPIA")
                                    {
                                        <span class="badge bg-primary">
                                            PROPIA
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            ALQUILADA
                                        </span>
                                    }

                                </td>


                                <!-- EMPRESA -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(volqueta.EmpresaPropietaria))
                                    {
                                        @volqueta.EmpresaPropietaria
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- ESTADO -->

                                <td>

                                    @if (volqueta.Estado == "1")
                                    {
                                        <span class="badge bg-success">
                                            ACTIVA
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            INACTIVA
                                        </span>
                                    }

                                </td>


                                <!-- ACCIONES -->

                                <td class="text-center no-print">

                                    <button type="button"
                                            class="btn btn-warning btn-sm btnEditarVolqueta"
                                            data-id="@volqueta.Id"
                                            data-placa="@volqueta.Placa"
                                            data-propiedad="@volqueta.Propiedad"
                                            data-empresa="@volqueta.EmpresaPropietaria"
                                            data-estado="@volqueta.Estado"
                                            data-observaciones="@volqueta.Observaciones"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalEditarVolqueta"
                                            title="Editar">

                                        <i class="fa-solid fa-pencil"></i>

                                    </button>


                                    <button type="button"
                                            class="btn btn-secondary btn-sm btnEstadoVolqueta"
                                            data-id="@volqueta.Id"
                                            title="Cambiar estado">

                                        <i class="fa-solid fa-power-off"></i>

                                    </button>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<!-- ========================================================= -->
<!-- MODAL NUEVA MÁQUINA -->
<!-- ========================================================= -->

<div class="modal fade"
     id="modalNuevaMaquina"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">


            <!-- HEADER -->

            <div class="modal-header">

                <h5 class="modal-title fw-bold">

                    <i class="fa-solid fa-truck-monster text-success me-2"></i>

                    Nueva Máquina

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <!-- FORMULARIO -->

            <form id="formNuevaMaquina">

                <div class="modal-body">


                    <!-- NOMBRE -->

                    <div class="mb-3">

                        <label class="form-label fw-bold">

                            Nombre / Tipo Maquinaria

                        </label>

                        <input type="text"
                               id="NombreMaquina"
                               class="form-control"
                               placeholder="Ej: RetroExcavadora KAT120"
                               required />

                    </div>


                    <!-- ESTADO -->

                    <div class="mb-3">

                        <label class="form-label fw-bold">

                            Estado de la Máquina

                        </label>

                        <select id="EstadoMaquina"
                                class="form-select"
                                required>

                            <option value="">
                                Seleccione un estado
                            </option>

                            <option value="1">
                                OPERATIVA
                            </option>

                            <option value="0">
                                NO OPERATIVA
                            </option>

                        </select>

                    </div>

                </div>


                <!-- FOOTER -->

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Cancelar

                    </button>


                    <button type="submit"
                            class="btn btn-success">

                        <i class="fa-solid fa-floppy-disk me-2"></i>

                        Guardar Máquina

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<!-- ========================================================= -->
<!-- MODAL EDITAR VOLQUETA -->
<!-- ========================================================= -->

<div class="modal fade"
     id="modalEditarVolqueta"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">


            <!-- HEADER -->

            <div class="modal-header">

                <h5 class="modal-title fw-bold">

                    <i class="fa-solid fa-pen-to-square text-warning me-2"></i>

                    Editar Volqueta

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <!-- FORMULARIO -->

            <form id="formEditarVolqueta">

                <input type="hidden"
                       id="EditarVolquetaId" />


                <div class="modal-body">

                    <div class="row">


                        <!-- PLACA -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-bold">

                                Placa

                            </label>

                            <input type="text"
                                   id="EditarPlacaVolqueta"
                                   class="form-control"
                                   maxlength="20"
                                   required />

                        </div>


                        <!-- PROPIEDAD -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-bold">

                                Tipo de Propiedad

                            </label>

                            <select id="EditarPropiedadVolqueta"
                                    class="form-select"
                                    required>

                                <option value="PROPIA">
                                    PROPIA
                                </option>

                                <option value="ALQUILADA">
                                    ALQUILADA
                                </option>

                            </select>

                        </div>


                        <!-- EMPRESA PROPIETARIA -->

                        <div class="col-md-12 mb-3">

                            <label class="form-label fw-bold">

                                Empresa Propietaria

                            </label>

                            <input type="text"
                                   id="EditarEmpresaPropietariaVolqueta"
                                   class="form-control"
                                   maxlength="150" />

                            <small class="text-muted">

                                Si la volqueta es propia, este campo puede quedar vacío.

                            </small>

                        </div>


                        <!-- ESTADO -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-bold">

                                Estado

                            </label>

                            <select id="EditarEstadoVolqueta"
                                    class="form-select"
                                    required>

                                <option value="1">
                                    ACTIVA
                                </option>

                                <option value="0">
                                    INACTIVA
                                </option>

                            </select>

                        </div>


                        <!-- OBSERVACIONES -->

                        <div class="col-md-12 mb-3">

                            <label class="form-label fw-bold">

                                Observaciones

                            </label>

                            <textarea id="EditarObservacionesVolqueta"
                                      class="form-control"
                                      rows="3"
                                      maxlength="500"></textarea>

                        </div>

                    </div>

                </div>


                <!-- FOOTER -->

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Cancelar

                    </button>


                    <button type="submit"
                            class="btn btn-warning">

                        <i class="fa-solid fa-floppy-disk me-2"></i>

                        Guardar Cambios

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<!-- ========================================================= -->
<!-- MODAL EDITAR MÁQUINA -->
<!-- ========================================================= -->

<div class="modal fade"
     id="modalEditarMaquina"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">


            <!-- HEADER -->

            <div class="modal-header">

                <h5 class="modal-title fw-bold">

                    <i class="fa-solid fa-pen-to-square text-warning me-2"></i>

                    Editar Máquina

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <!-- FORMULARIO -->

            <form id="formEditarMaquina">

                <input type="hidden"
                       id="EditarId" />


                <div class="modal-body">


                    <!-- NOMBRE -->

                    <div class="mb-3">

                        <label class="form-label fw-bold">

                            Nombre / Tipo Maquinaria

                        </label>

                        <input type="text"
                               id="EditarNombre"
                               class="form-control"
                               required />

                    </div>


                    <!-- ESTADO -->

                    <div class="mb-3">

                        <label class="form-label fw-bold">

                            Estado

                        </label>

                        <select id="EditarEstado"
                                class="form-select"
                                required>

                            <option value="1">
                                OPERATIVA
                            </option>

                            <option value="0">
                                NO OPERATIVA
                            </option>

                        </select>

                    </div>

                </div>


                <!-- FOOTER -->

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Cancelar

                    </button>

                    <button type="submit"
                            class="btn btn-warning">

                        <i class="fa-solid fa-floppy-disk me-2"></i>

                        Guardar Cambios

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<!-- ========================================================= -->
<!-- MODAL NUEVA VOLQUETA -->
<!-- ========================================================= -->

<div class="modal fade"
     id="modalNuevaVolqueta"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">


            <!-- HEADER -->

            <div class="modal-header">

                <h5 class="modal-title fw-bold">

                    <i class="fa-solid fa-truck text-success me-2"></i>

                    Nueva Volqueta

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <!-- FORMULARIO -->

            <form id="formNuevaVolqueta">

                <div class="modal-body">

                    <div class="row">


                        <!-- PLACA -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-bold">

                                Placa

                            </label>

                            <input type="text"
                                   id="PlacaVolqueta"
                                   class="form-control"
                                   placeholder="Ej: ABC123"
                                   maxlength="20"
                                   required />

                        </div>


                        <!-- PROPIEDAD -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-bold">

                                Tipo de Propiedad

                            </label>

                            <select id="PropiedadVolqueta"
                                    class="form-select"
                                    required>

                                <option value="">
                                    Seleccione...
                                </option>

                                <option value="PROPIA">
                                    PROPIA
                                </option>

                                <option value="ALQUILADA">
                                    ALQUILADA
                                </option>

                            </select>

                        </div>


                        <!-- EMPRESA PROPIETARIA -->

                        <div class="col-md-12 mb-3">

                            <label class="form-label fw-bold">

                                Empresa Propietaria

                            </label>

                            <input type="text"
                                   id="EmpresaPropietariaVolqueta"
                                   class="form-control"
                                   placeholder="Solo si la volqueta es alquilada"
                                   maxlength="150" />

                            <small class="text-muted">

                                Si la volqueta es propia, este campo puede quedar vacío.

                            </small>

                        </div>


                        <!-- OBSERVACIONES -->

                        <div class="col-md-12 mb-3">

                            <label class="form-label fw-bold">

                                Observaciones

                            </label>

                            <textarea id="ObservacionesVolqueta"
                                      class="form-control"
                                      rows="3"
                                      maxlength="500"
                                      placeholder="Observaciones adicionales..."></textarea>

                        </div>

                    </div>

                </div>


                <!-- FOOTER -->

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Cancelar

                    </button>


                    <button type="submit"
                            class="btn btn-success">

                        <i class="fa-solid fa-floppy-disk me-2"></i>

                        Guardar Volqueta

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    <script src="~/js/maquinaria.js"
            asp-append-version="true">
    </script>
}