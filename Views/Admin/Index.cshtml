@using Microsoft.AspNetCore.Http
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@

@model IEnumerable<FormularioMaquinaria.Models.ReporteMaquinaria>

@{
    ViewData["Title"] = "Panel Administrativo";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />

 <!-- HEADER DASHBOARD -->

<div class="row gx-4 gy-1 mb-1">

    <!-- REPORTES -->

    <div class="col-xl-3 col-md-6">

        <div class="card kpi-card border-0 shadow-sm">

            <div class="card-body d-flex justify-content-between align-items-center">

                <div>

                    <span class="text-muted fw-semibold">
                        REPORTES
                    </span>

                    <h2 class="fw-bold mt-2 mb-1">
                        @ViewBag.TotalReportes
                    </h2>

                    <small class="text-success">
                        <i class="fa-solid fa-arrow-trend-up"></i>
                        Sistema activo
                    </small>

                </div>

                <div class="icon-box bg-primary">

                    <i class="fa-solid fa-file-lines"></i>

                </div>

            </div>

        </div>

    </div>

    <!-- Operadores -->

    <div class="col-xl-3 col-md-6">

        <div class="card kpi-card border-0 shadow-sm">

            <div class="card-body d-flex justify-content-between align-items-center">

                <div>

                    <span class="text-muted fw-semibold">
                        OPERADORES
                    </span>

                    <h2 class="fw-bold mt-2 mb-1">
                        @ViewBag.TotalOperadores
                    </h2>

                    <small class="text-primary">

                        Personal registrado 

                    </small>

                </div>

                <div class="icon-box bg-success">

                    <i class="fa-solid fa-users"></i>

                </div>

            </div>

        </div>  

    </div>

    <!-- Máquinas -->

    <div class="col-xl-3 col-md-6">

        <div class="card kpi-card border-0 shadow-sm">

            <div class="card-body d-flex justify-content-between align-items-center">

                <div>

                    <span class="text-muted fw-semibold">
                        MÁQUNAS
                    </span>

                    <h2 class="fw-bold mt-2 mb-1">
                        @ViewBag.TotalMaquinas
                    </h2>

                    <small class="text-warning">

                        Inventario

                    </small>

                </div>

                <div class="icon-box bg-warning">

                    <i class="fa-solid fa-truck-monster"></i>

                </div>

            </div>

        </div>

    </div>

    <!-- Horas -->

    <div class="col-xl-3 col-md-6">

        <div class="card kpi-card border-0 shadow-sm">

            <div class="card-body d-flex justify-content-between align-items-center">

                <div>

                    <span class="text-muted fw-semibold">
                        HORAS TOTALES
                    </span>

                    <h2 class="fw-bold mt-2 mb-1">
                        @ViewBag.HorasTotales
                    </h2>

                    <small class="text-danger">

                        Horómetro acumulado

                    </small>

                </div>

                <div class="icon-box bg-danger">

                    <i class="fa-solid fa-clock"></i>

                </div>

            </div>

        </div>

    </div>

</div> 

<div class="row gx-4 gy-1 mb-1">

    <!-- Máquinas fuera de servicio -->

    <div class="col-xl-3 col-md-6">

        <div class="card kpi-card border-0 shadow-sm">

            <div class="card-body d-flex justify-content-between align-items-center">

                <div>

                    <span class="text-muted fw-semibold">
                        MÁQUINAS FUERA
                    </span>

                    <h2 class="fw-bold mt-2 mb-1">
                        @ViewBag.MaquinasFueraServicio.Count
                    </h2>

                    <small class="text-danger">
                        Fuera de servicio
                    </small>

                </div>

                <div class="icon-box bg-danger">

                    <i class="fa-solid fa-triangle-exclamation"></i>

                </div>

            </div>

        </div>

    </div>

    <!-- Maquinas operativas -->

    <div class="col-xl-3 col-md-6">

        <div class="card kpi-card border-0 shadow-sm">

            <div class="card-body d-flex justify-content-between align-items-center">

                <div>

                    <span class="text-muted fw-semibold">
                        MÁQUINAS OPERATIVAS
                    </span>

                    <h2 class="fw-bold mt-2 mb-1">
                        @ViewBag.MaquinasOperativas
                    </h2>

                    <small class="text-warning">
                        En funcinamineto
                    </small>

                </div>

                <div class="icon-box bg-warning">

                    <i class="fa-solid fa-user-clock"></i>

                </div>

            </div>

        </div>

    </div>

    <!-- Horas acumuladas -->

    <div class="col-xl-3 col-md-6">

        <div class="card kpi-card border-0 shadow-sm">

            <div class="card-body d-flex justify-content-between align-items-center">

                <div>

                    <span class="text-muted fa-clipboard-list">
                        POR EVALUAR
                    </span>

                    <h2 class="fw-bold mt-2 mb-1">
                        @ViewBag.PendientesEvaluacion
                    </h2>

                    <small class="text-primary">
                        Reporte sin evaluar
                    </small>

                </div>

                <div class="icon-box bg-primary">

                    <i class="fa-solid fa-clock"></i>

                </div>

            </div>

        </div>

    </div>

    <!-- Día operativo -->

    <div class="col-xl-3 col-md-6">

        <div class="card kpi-card border-0 shadow-sm">

            <div class="card-body d-flex justify-content-between align-items-center">

                <div>

                    <span class="text-muted fw-semibold">
                        DÍA OPERATIVO
                    </span>

                    <h2 class="fw-bold mt-2 mb-1">
                        @DateTime.Now.ToString("dd")
                    </h2>

                    <small class="text-success">
                        @DateTime.Now.ToString("MMMM yyyy")
                    </small>

                </div>

                <div class="icon-box bg-success">

                    <i class="fa-solid fa-calendar-check"></i>

                </div>

            </div>

        </div>

    </div>

</div>

<!-- CENTRO OPERACIONAL -->

<div class="row g-4 mb-1 fade-up">

    <div class="col-lg-6">

        <div class="chart-card">

            <h5 class="fw-bold mb-4">

                ⏱ HORAS TRABAJADAS POR MÁQUINA

            </h5>

            <canvas id="horasChart" height="120"></canvas>

        </div>

    </div>

    <div class="col-lg-6">

        <div class="chart-card">

            <h5 class="fw-bold mb-4">

                📄 REPORTE OPERADORES

            </h5>

            <canvas id="operadoresChart" height="120"></canvas>

        </div>

    </div>

</div> 

<!-- Últimos reportes -->
<div class="row gx-4 gy-1 mb-1">

    <div class="col-12">

        <div class="card border-0 shadow-sm">

            <div class="card-header bg-white border-0">

                <h4 class="fw-bold mb-0">
                    📄 ÚLTIMOS OPERADORES
                </h4>

            </div>

            <div class="card-body p-0">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>Fecha</th>
                            <th>Operador</th>
                            <th>Máquina</th>
                            <th>Horas</th>
                            <th>Estado</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in ViewBag.UltimosReportes)
                        {

                            <tr>

                                <td>@item.Fecha.ToString("dd/MM/yyyy")</td>

                                <td>@item.NombreOperador</td>

                                <td>@item.NombreMaquina</td>

                                <td>@item.HorasTrabajadas</td>

                                <td>

                                    @if (item.EstadoMaquina == 1)
                                    {
                                        <span class="badge bg-success">
                                            Operativa
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            No Operativa
                                        </span>
                                    }

                                </td>

                            </tr>

                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>

<div class="row gx-4 gy-1 mb-1">

    <!-- ACTIVIDAD RECIENTE -->
    <div class="col-xl-4">

        <div class="card dashboard-card shadow-sm border-0 h-100">

            <div class="card-header bg-white border-0">

                <h6 class="fw-bold text-uppercase mb-0">
                    ACTIVIDADES RECIENTES
                </h6>

            </div>

            <div class="card-body">

                <div class="actividad-scroll">

                    @if (ViewBag.ActividadReciente != null)
                    {
                        foreach (var item in ViewBag.ActividadReciente)
                        {
                            <div class="d-flex align-items-start mb-3 pb-3 border-bottom">

                                <div class="me-3">

                                    <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center"
                                         style="width:40px;height:40px;">

                                        <i class="fa-solid fa-file-lines"></i>

                                    </div>

                                </div>

                                <div>

                                    <strong>@item.NombreOperador</strong><br />

                                    <small class="text-muted">
                                        Registró un reporte para
                                        <strong>@item.NombreMaquina</strong>
                                    </small>

                                    <br />

                                    <small class="text-secondary">
                                        @item.Fecha.ToString("dd/MM/yyyy HH:mm")
                                    </small>

                                </div>

                            </div>
                        }
                    }

                </div>

            </div>

        </div>

    </div>

    <!-- ALERTAS -->
    <div class="col-xl-4">

        <div class="card dashboard-card shadow-sm border-0 h-100">

            <div class="card-header bg-white border-0">

                <h6 class="fw-bold text-uppercase mb-0">
                    Alertas
                </h6>

            </div>

            <div class="card-body p-0">

                <table class="table table-hover mb-0">

                    <thead class="table-light">

                        <tr>
                            <th>Máquina</th>
                            <th>Fecha</th>
                            <th>Estado</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in ViewBag.MaquinasCriticas)
                        {
                            <tr>

                                <td>@item.NombreMaquina</td>

                                <td>@item.Fecha.ToString("dd/MM/yyyy")</td>

                                <td>
                                    <span class="badge bg-danger">
                                        No Operativa
                                    </span>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    <!-- RESUMEN DEL PERÍODO -->
    <div class="col-xl-4">

        <div class="card dashboard-card shadow-sm border-0 h-100">

            <div class="card-header bg-white border-0">

                <h6 class="fw-bold mb-0">
                    RESUMEN DEL PERÍODO
                </h6>

            </div>

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">

                    <div>
                        <i class="fa-regular fa-clock text-primary me-2"></i>
                        Horas trabajadas totales
                    </div>

                    <strong>
                        @ViewBag.TotalHoras h
                    </strong>

                </div>

                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">

                    <div>
                        <i class="fa-regular fa-calendar text-primary me-2"></i>
                        Promedio de horas por día
                    </div>

                    <strong>
                        @ViewBag.PromedioHorasDia h
                    </strong>

                </div>

                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">

                    <div>
                        <i class="fa-regular fa-file-lines text-primary me-2"></i>
                        Reportes registrados
                    </div>

                    <strong>
                        @ViewBag.TotalReportes
                    </strong>

                </div>

                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">

                    <div>
                        <i class="fa-regular fa-star text-primary me-2"></i>
                        Evaluaciones realizadas
                    </div>

                    <strong>
                        @ViewBag.TotalEvaluaciones
                    </strong>

                </div>

                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">

                    <div>
                        <i class="fa-solid fa-user-gear text-primary me-2"></i>
                        Operadores activos
                    </div>

                    <strong>
                        @ViewBag.TotalOperadores
                    </strong>

                </div>

                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">

                    <div>
                        <i class="fa-solid fa-circle-check text-success me-2"></i>
                        Máquinas operativas
                    </div>

                    <strong>
                        @ViewBag.MaquinasOperativas
                    </strong>

                </div>

                <div class="d-flex justify-content-between align-items-center py-2">

                    <div>
                        <i class="fa-solid fa-triangle-exclamation text-danger me-2"></i>
                        Máquinas no operativas
                    </div>

                    <strong>
                        @ViewBag.MaquinasNoOperativas
                    </strong>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        const maquinas=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.MaquinasChart));

        const horas=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.HorasChart));

        const operadores=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.OperadoresChart));

        const reportes=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ReportesChart));

                new Chart(document.getElementById('horasChart'), {

            type: 'bar',

            data: {

                labels: maquinas,

                datasets: [{

                    label: 'Horas Trabajadas',

                    data: horas,

                    backgroundColor: '#0f2f44',

                    borderRadius: 8

                }]

            },

            options: {

                responsive: true,

                maintainAspectRatio: true,

                plugins: {

                    legend: {

                        display: false

                    }

                },

                scales: {

                    y: {

                        beginAtZero: true

                    }

                }

            }

        });

            new Chart(document.getElementById('operadoresChart'), {

            type: 'bar',

            data: {

                labels: operadores,

                datasets: [{

                    label: 'Reportes',

                    data: reportes,

                    backgroundColor: '#f0ad00',

                    borderRadius: 8

                }]

            },

            options: {

                responsive: true,

                maintainAspectRatio: true,

                plugins: {

                    legend: {

                        display: false

                    }

                },

                scales: {

                    y: {

                        beginAtZero: true,

                        ticks: {

                            precision: 0

                        }

                    }

                }

            }

        });

    </script>

}
