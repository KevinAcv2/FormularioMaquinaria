@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

@model IEnumerable<Maquinarias.Models.ReporteMaquinaria>

@{
    ViewData["Title"] = "Panel Administrativo";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

    body {
        background: #eef2f6;
    }

    .header-admin {
        background: linear-gradient(135deg,#0f2f44,#174d6d);
        border-radius: 25px;
        padding: 35px;
        color: white;
        margin-bottom: 30px;
        box-shadow: 0px 10px 25px rgba(0,0,0,.15);
    }

    .logo-admin {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        border: 4px solid #f0ad00;
        object-fit: cover;
        background: white;
    }

    .titulo-admin {
        font-size: 34px;
        font-weight: 800;
    }

    .subtitulo {
        color: #d8d8d8;
    }

    .card-filtro {
        border: none;
        border-radius: 20px;
        padding: 25px;
        box-shadow: 0px 5px 15px rgba(0,0,0,.08);
        margin-bottom: 25px;
        background: white;
    }

    .form-control,
    .form-select {
        border-radius: 12px;
        padding: 12px;
    }

    .btn-filtrar {
        background: #f0ad00;
        border: none;
        font-weight: 800;
        border-radius: 12px;
        color: black;
    }

        .btn-filtrar:hover {
            background: #d89b00;
        }

    .table-card {
        border: none;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0px 5px 15px rgba(0,0,0,.08);
    }

    .table thead {
        background: #0f2f44;
        color: white;
    }

    .table tbody tr:hover {
        background: #f5f7fa;
    }

    .badge-industrial {
        background: #0f2f44;
        color: white;
        padding: 8px 14px;
        border-radius: 12px;
        font-size: 13px;
    }

    .horometro {
        font-weight: 700;
        color: #174d6d;
    }

</style>

<div class="container-fluid mt-4">

    <!-- HEADER -->

    <div class="header-admin d-flex justify-content-between align-items-center">

        <div>

            <h1 class="titulo-admin">
                PANEL ADMINISTRATIVO
            </h1>

            <p class="subtitulo">
                Control y seguimiento de maquinaria pesada
            </p>

        </div>

        <img src="~/img/Logo.png"
             class="logo-admin" />

    </div>

    <!-- FILTROS -->

    <div class="card card-filtro">

        <form method="get">

            <div class="row g-3">

                <div class="col-md-4">

                    <input type="text"
                           name="buscar"
                           class="form-control"
                           placeholder="Buscar operador o máquina..." />

                </div>

                <div class="col-md-3">

                    <select name="tipoMaquina"
                            class="form-select">

                        <option value="">
                            Todas las máquinas
                        </option>

                        <option>Motoniveladora</option>
                        <option>Bulldozer</option>
                        <option>Retroexcavadora</option>
                        <option>Excavadora</option>
                        <option>Vibrocompactador</option>

                    </select>

                </div>

                <div class="col-md-2">

                    <button type="submit"
                            class="btn btn-filtrar w-100">

                        FILTRAR

                    </button>

                </div>

            </div>

        </form>

    </div>

    <!-- TABLA -->

    <div class="card table-card">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead>

                    <tr>

                        <th>Operador</th>
                        <th>Máquina</th>
                        <th>Tipo</th>

                        <th>Horómetro Inicial</th>
                        <th>Horómetro Final</th>

                        <th>Horas Trabajadas</th>

                        <th>Foto Inicial</th>
                        <th>Foto Final</th>

                        <th>Fecha</th>

                        <th>Observaciones</th>

                        <th>Acciones</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                <strong>@item.NombreOperador</strong>
                            </td>

                            <td>
                                @item.NombreMaquina
                            </td>

                            <td>
                                <span class="badge-industrial">
                                    @item.TipoMaquina
                                </span>
                            </td>

                            <td class="horometro">
                                @item.HorometroInicial
                            </td>

                            <td class="horometro">
                                @item.HorometroFinal
                            </td>

                            <td>

                                @{
                                    var horas =
                                    item.HorometroFinal -
                                    item.HorometroInicial;
                                }

                                <span class="badge bg-success">
                                    @horas hrs
                                </span>

                            </td>

                            <td>

                                @if (!string.IsNullOrEmpty(item.FotoHorometroInicial))
                                {
                                    <a href="@item.FotoHorometroInicial"
                                       target="_blank"
                                       class="btn btn-primary btn-sm">

                                        Ver Foto

                                    </a>
                                }

                            </td>

                            <td>

                                @if (!string.IsNullOrEmpty(item.FotoHorometroFinal))
                                {
                                    <a href="@item.FotoHorometroFinal"
                                       target="_blank"
                                       class="btn btn-primary btn-sm">

                                        Ver Foto

                                    </a>
                                }

                            </td>

                            <td>
                                @item.Fecha.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                @item.Observaciones
                            </td>

                            <td>

                                <a asp-action="Editar"
                                   asp-route-id="@item.Id"
                                   class="btn btn-warning btn-sm">

                                    Editar

                                </a>

                                <a asp-action="Eliminar"
                                   asp-route-id="@item.Id"
                                   class="btn btn-danger btn-sm">

                                    Eliminar

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>