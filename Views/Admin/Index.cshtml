@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

@model IEnumerable<Maquinarias.Models.ReporteMaquinaria>

@{
    ViewData["Title"] = "Panel Administrativo";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

    body {
        background: #eef2f6;
    }

    .header-admin {
        background: linear-gradient(135deg,#0f2f44,#174d6d);
        border-radius: 25px;
        padding: 35px;
        color: white;
        margin-bottom: 30px;
        box-shadow: 0px 10px 25px rgba(0,0,0,.15);
    }

    .logo-admin {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        border: 4px solid #f0ad00;
        object-fit: cover;
        background: white;
    }

    .titulo-admin {
        font-size: 34px;
        font-weight: 800;
    }

    .subtitulo {
        color: #d8d8d8;
    }

    .card-filtro {
        border: none;
        border-radius: 20px;
        padding: 25px;
        box-shadow: 0px 5px 15px rgba(0,0,0,.08);
        margin-bottom: 25px;
        background: white;
    }

    .form-control,
    .form-select {
        border-radius: 12px;
        padding: 12px;
    }

    .btn-filtrar {
        background: #f0ad00;
        border: none;
        font-weight: 800;
        border-radius: 12px;
        color: black;
    }

        .btn-filtrar:hover {
            background: #d89b00;
        }

    .table-card {
        border: none;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0px 5px 15px rgba(0,0,0,.08);
    }

    .table thead {
        background: #0f2f44;
        color: white;
    }

    .table tbody tr:hover {
        background: #f5f7fa;
    }

    .badge-industrial {
        background: #0f2f44;
        color: white;
        padding: 8px 14px;
        border-radius: 12px;
        font-size: 13px;
    }

    .horometro {
        font-weight: 700;
        color: #174d6d;
    }

</style>

<div class="container-fluid mt-4">

    <!-- HEADER -->

    <div class="header-admin d-flex justify-content-between align-items-center">

        <div>

            <h1 class="titulo-admin">
                PANEL ADMINISTRATIVO
            </h1>

            <p class="subtitulo">
                Control y seguimiento de maquinaria pesada
            </p>

        </div>

        <img src="~/img/Logo.png"
             class="logo-admin" />

    </div>

    <div class="row mb-4">

        <div class="col-md-3">
            <div class="card shadow border-0 text-center">
                <div class="card-body">
                    <h5>📄 Reportes</h5>
                    <h2>@ViewBag.TotalReportes</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow border-0 text-center">
                <div class="card-body">
                    <h5>👷 Operadores</h5>
                    <h2>@ViewBag.TotalOperadores</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow border-0 text-center">
                <div class="card-body">
                    <h5>🚜 Máquinas</h5>
                    <h2>@ViewBag.TotalMaquinas</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow border-0 text-center">
                <div class="card-body">
                    <h5>⏱ Horas Totales</h5>
                    <h2>@ViewBag.HorasTotales</h2>
                </div>
            </div>
        </div>

    </div>

    <div class="card card-filtro mb-4">
        <div class="card card-filtro mb-4">

            <h3 class="mb-4">
                🏆 Evaluación de Operadores
            </h3>

            <div class="row">

                @foreach (var op in ViewBag.RankingOperadores)
                {
                    var puntuacion =
                    (op.TotalReportes * 5) +
                    (int)op.HorasTrabajadas +
                    (op.Observaciones * 2);

                    if (puntuacion > 100)
                    {
                        puntuacion = 100;
                    }

                    <div class="col-md-4 mb-4">

                        <div class="card border-0 shadow-sm">

                            <div class="card-body">

                                <h5 class="fw-bold">
                                    👷 @op.Operador
                                </h5>

                                <hr />

                                <p>
                                    📄 Reportes:
                                    <strong>@op.TotalReportes</strong>
                                </p>

                                <p>
                                    ⏱ Horas:
                                    <strong>@op.HorasTrabajadas</strong>
                                </p>

                                <p>
                                    📝 Observaciones:
                                    <strong>@op.Observaciones</strong>
                                </p>

                                <div class="progress mb-2"
                                     style="height:25px;">

                                    <div class="progress-bar
                        @(puntuacion >= 90 ? "bg-success"
                                                             : puntuacion >= 70 ? "bg-warning"
                                                             : "bg-danger")"
                                         role="progressbar"
                                         style="width:@puntuacion%">

                                        @puntuacion%

                                    </div>

                                </div>

                                @if (puntuacion >= 90)
                                {
                                    <span class="badge bg-success">
                                        Excelente
                                    </span>
                                }
                                else if (puntuacion >= 70)
                                {
                                    <span class="badge bg-warning text-dark">
                                        Bueno
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Requiere Mejora
                                    </span>
                                }

                            </div>

                        </div>

                    </div>
                }

            </div>

        </div>

        <div class="row">

            <div class="col-md-6">

                <h4>👷 Operadores</h4>

                <a href="/Operadores/Index"
                   class="btn btn-primary">

                    Administrar Operadores

                </a>

            </div>

            <div class="col-md-6">

                <h4>🚜 Máquinas</h4>

                <a href="/Maquinas/Index"
                   class="btn btn-success">

                    Administrar Máquinas

                </a>

            </div>

        </div>

    </div>

    <!-- FILTROS -->

    <div class="card card-filtro">

        <form method="get">

            <div class="row g-3">

                <div class="col-md-4">

                    <input type="text"
                           name="buscar"
                           class="form-control"
                           placeholder="Buscar operador o máquina..." />

                </div>

                <div class="col-md-3">

                    <select name="tipoMaquina"
                            class="form-select">

                        <option value="">
                            Todas las máquinas
                        </option>

                        <option>Motoniveladora</option>
                        <option>Bulldozer</option>
                        <option>Retroexcavadora</option>
                        <option>Excavadora</option>
                        <option>Vibrocompactador</option>

                    </select>

                </div>

                <div class="col-md-2">

                    <button type="submit"
                            class="btn btn-filtrar w-100">

                        FILTRAR

                    </button>

                </div>

            </div>

        </form>

    </div>

    <div class="mb-3">

    <a asp-action="ExportarExcel"
       class="btn btn-success">

        DESCARGAR EXCEL

    </a>

        <a asp-action="ExportarPdf"
           class="btn btn-danger">

            DESCARGAR PDF

        </a>

</div>

    

    <!-- TABLA -->

    <div class="card table-card">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead>

                    <tr>

                        <th>Operador</th>
                        <th>Máquina</th>

                        <th>Horómetro Inicial</th>
                        <th>Horómetro Final</th>

                        <th>Horas Trabajadas</th>

                        <th>Foto Inicial</th>
                        <th>Foto Final</th>

                        <th>Fecha</th>

                        <th>Observaciones</th>

                        <th>Acciones</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                <strong>@item.NombreOperador</strong>
                            </td>

                            <td>
                                @item.NombreMaquina
                            </td>

                            

                            <td class="horometro">
                                @item.HorometroInicial
                            </td>

                            <td class="horometro">
                                @item.HorometroFinal
                            </td>

                            <td>

                                @{
                                    var horas =
                                    item.HorometroFinal -
                                    item.HorometroInicial;
                                }

                                <span class="badge bg-success">
                                    @horas hrs
                                </span>

                            </td>

                            <td>

                                @if (!string.IsNullOrEmpty(item.FotoHorometroInicial))
                                {
                                    <a href="@item.FotoHorometroInicial"
                                       target="_blank"
                                       class="btn btn-primary btn-sm">

                                        Ver Foto

                                    </a>
                                }

                            </td>

                            <td>

                                @if (!string.IsNullOrEmpty(item.FotoHorometroFinal))
                                {
                                    <a href="@item.FotoHorometroFinal"
                                       target="_blank"
                                       class="btn btn-primary btn-sm">

                                        Ver Foto

                                    </a>
                                }

                            </td>

                            <td>
                                @item.Fecha.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                @item.Observaciones
                            </td>

                            <td>

                                <a asp-action="Editar"
                                   asp-route-id="@item.Id"
                                   class="btn btn-warning btn-sm">

                                    Editar

                                </a>

                                <a asp-action="Eliminar"
                                   asp-route-id="@item.Id"
                                   class="btn btn-danger btn-sm">

                                    Eliminar

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>