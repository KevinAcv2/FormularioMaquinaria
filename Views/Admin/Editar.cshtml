@model FormularioMaquinaria.Models.ReporteMaquinaria

@{
    ViewData["Title"] = "Editar Reporte";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-5">

    <div class="card shadow-lg">

        <div class="card-header bg-warning">

            <h3 class="mb-0">
                Editar Reporte
            </h3>

        </div>

        <div class="card-body">
                
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }

            <form asp-action="Editar" method="post">

                <input asp-for="Id" type="hidden" />

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Operador
                        </label>

                        <input asp-for="NombreOperador"
                               class="form-control" />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Máquina
                        </label>

                        <select asp-for="NombreMaquina"
                                asp-items="ViewBag.Maquinas"
                                class="form-select">
                            <option value="">
                                Seleccione una máquina
                            </option>
                        </select>

                    </div>

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Tipo de Máquina
                    </label>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Horómetro Inicial
                        </label>

                        <input asp-for="HorometroInicial"
                               class="form-control" />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Horómetro Final
                        </label>

                        <input asp-for="HorometroFinal"
                               class="form-control" />

                    </div>

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Observaciones
                    </label>

                    <textarea asp-for="Observaciones"
                              class="form-control"
                              rows="4"></textarea>

                    <hr />

                    <h4 class="mt-4 mb-3">
                        ⭐ Evaluación del Operador
                    </h4>

                </div>

                @if (!string.IsNullOrEmpty(Model.FotoHorometroInicial))
                {
                    <div class="mb-3">

                        <label class="form-label fw-bold">
                            Foto Horómetro Inicial
                        </label>

                        <br />

                        <img src="@Model.FotoHorometroInicial"
                             class="img-thumbnail"
                             style="max-width:300px;" />

                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.FotoHorometroFinal))
                {
                    <div class="mb-3">

                        <label class="form-label fw-bold">
                            Foto Horómetro Final
                        </label>

                        <br />

                        <img src="@Model.FotoHorometroFinal"
                             class="img-thumbnail"
                             style="max-width:300px;" />

                    </div>
                }

                <button type="submit"
                        class="btn btn-success">

                    Guardar Cambios

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancelar

                </a>

            </form>

        </div>

    </div>

</div>