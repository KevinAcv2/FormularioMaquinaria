@model Maquinarias.ViewModels.EstadisticasViewModel

@{
    ViewData["Title"] = "Estadísticas";
    var topCount = Math.Min(Model.TopOperadores?.Count ?? 0, Model.HorasOperadores?.Count ?? 0);
}

<link rel="stylesheet" href="~/css/estadisticas.css" asp-append-version="true" />

<div class="container-fluid">

    <!-- ENCABEZADO -->
    <div class="estadisticas-header d-flex justify-content-between align-items-start mb-3">
        <div>
            <h2>📊 Estadísticas</h2>
            <p class="text-muted mb-0">
                Indicadores de operación y rendimiento.
            </p>
        </div>
    </div>

    <!-- TARJETAS -->
    <div class="row g-3 mb-3">

        <!-- REPORTES -->
        <div class="col-xl-3 col-md-6">
            <div class="card indicador-card border-0 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>
                        <small class="text-muted">Total Reportes</small>
                        <h2 class="fw-bold mt-2 mb-0">@Model.TotalReportes</h2>
                    </div>

                    <div class="icono-card bg-primary">
                        <i class="fa-solid fa-file-lines"></i>
                    </div>

                </div>
            </div>
        </div>

        <!-- HORAS -->
        <div class="col-xl-3 col-md-6">
            <div class="card indicador-card border-0 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>
                        <small class="text-muted">Horas Trabajadas</small>
                        <h2 class="fw-bold mt-2 mb-0">@Model.TotalHoras</h2>
                    </div>

                    <div class="icono-card bg-success">
                        <i class="fa-solid fa-clock"></i>
                    </div>

                </div>
            </div>
        </div>

        <!-- OPERADORES -->
        <div class="col-xl-3 col-md-6">
            <div class="card indicador-card border-0 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>
                        <small class="text-muted">Operadores</small>
                        <h2 class="fw-bold mt-2 mb-0">@Model.TotalOperadores</h2>
                    </div>

                    <div class="icono-card bg-warning">
                        <i class="fa-solid fa-user-gear"></i>
                    </div>

                </div>
            </div>
        </div>

        <!-- MÁQUINAS -->
        <div class="col-xl-3 col-md-6">
            <div class="card indicador-card border-0 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>
                        <small class="text-muted">Máquinas</small>
                        <h2 class="fw-bold mt-2 mb-0">@Model.TotalMaquinas</h2>
                    </div>

                    <div class="icono-card bg-danger">
                        <i class="fa-solid fa-truck-monster"></i>
                    </div>

                </div>
            </div>
        </div>

    </div>

    <!-- ===================== DASHBOARD ===================== -->
    <div class="row g-3">

        <!-- ================= IZQUIERDA ================= -->
        <div class="col-lg-8">

            <!-- Reportes por Máquina -->
            <div class="chart-card">
                <h5 class="fw-bold">
                    📊 Reportes por Máquina
                </h5>

                <canvas id="graficoMaquinas"></canvas>
            </div>

        </div>

        <!-- ================= DERECHA ================= -->
        <div class="col-lg-4">

            <!-- Reportes por Frente -->
            <div class="chart-card">
                <h5 class="fw-bold">
                    📝 Reportes por Frente
                </h5>

                <canvas id="graficoFrentes"></canvas>
            </div>

        </div>

        <!-- ================= IZQUIERDA ================= -->
        <div class="col-lg-8">

            <!-- Tendencia Semanal -->
            <div class="chart-card">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">
                        📈 Tendencia Semanal
                    </h5>

                    <input type="date"
                           id="fechaSemana"
                           class="form-control"
                           style="width:190px;">
                </div>

                <canvas id="graficoSemana" height="110"></canvas>

            </div>

        </div>

        <!-- ================= DERECHA ================= -->
        <div class="col-lg-4">

            <!-- Top Operadores -->
            <div class="chart-card">

                <h5 class="fw-bold">
                    🏆 Top Operadores
                </h5>

                <div class="top-operadores-scroll">

                    @for (int i = 0; i < topCount; i++)
                    {
                        <div class="operador-item d-flex justify-content-between align-items-center">

                            <div class="d-flex align-items-center gap-3">

                                <div class="operador-avatar">


                                    @if (i == 0)
                                    {
                                        <span class="badge bg-secondary rounded-pill">
                                        @(i + 1)
                                        </span>
                                    }
                                    else if (i == 1)
                                    {
                                        <span class="badge bg-secondary rounded-pill">
                                        @(i + 1)
                                        </span>

                                    }
                                    else if (i == 2)
                                    {
                                        <span class="badge bg-secondary rounded-pill">
                                        @(i + 1)
                                                </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary rounded-pill">
                                            @(i + 1)
                                        </span>
                                    }

                                </div>

                                <strong>
                                    @Model.TopOperadores[i]
                                </strong>

                            </div>

                            <span class="badge bg-primary rounded-pill">
                                @Model.HorasOperadores[i] h
                            </span>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        window.estadisticasData = {
            maquinasLabels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Maquinas ?? new List<string>())),
            maquinasData: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CantidadReportes ?? new List<int>())),

            frentesLabels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Frente ?? new List<string>())),
            frentesData: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CantidadFrentes ?? new List<int>())),

            mesesLabels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Meses ?? new List<string>())),
            mesesData: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ReportePorMes ?? new List<int>()))
        };
    </script>

    <script src="~/js/estadisticas.js" asp-append-version="true"></script>
}