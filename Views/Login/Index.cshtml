@model Maquinarias.Models.LoginViewModel

@{
    ViewData["Title"] = "Acceso Administrador";
}

<div class="container mt-5">

    <div class="card shadow-lg mx-auto" style="max-width:450px;">

        <div class="card-header bg-dark text-white text-center">
            <h3>ADMINISTRACIÓN</h3>
        </div>

        <div class="card-body">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }

            <form method="post">

                <div class="mb-3">
                    <label>Usuario</label>
                    <input asp-for="Usuario" class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Contraseña</label>
                    <input asp-for="Password"
                           type="password"
                           class="form-control" />
                </div>

                <button type="submit"
                        class="btn btn-primary w-100">
                    Ingresar
                </button>

            </form>

        </div>

    </div>

</div>