@model IEnumerable<FormularioMaquinaria.Models.ViajeMaterial>

@{
    ViewData["Title"] = "Reporte de Viajes de Material";

    // Diccionario de tarifas por tipo de material (Precio por m³ en COP)
    var tarifasMaterial = new Dictionary<string, decimal>(StringComparer.OrdinalIgnoreCase)
    {
        { "Arena", 3000m },
        { "Gravilla", 3500m },
        { "Piedra", 4000m },
        { "Subbase", 3000m }
    };
    decimal tarifaPorDefecto = 3000m;

    // Cálculos dinámicos basados en los datos filtrados actuales
    int totalViajes = Model != null ? Model.Count() : 0;
    decimal volumenTotal = Model != null ? Model.Sum(v => v.VolumenM3) : 0;

    decimal costoTotal = 0;
    if (Model != null)
    {
        foreach (var v in Model)
        {
            string mat = v.Material?.Trim() ?? "";
            decimal precioM3 = tarifasMaterial.ContainsKey(mat) ? tarifasMaterial[mat] : tarifaPorDefecto;
            costoTotal += v.VolumenM3 * precioM3;
        }
    }
}

<link rel="stylesheet"
      href="~/css/historial.css"
      asp-append-version="true" />

<div class="container-fluid historial-page">

    <div id="viajeMaterialReporte">

        <!-- ======================================================== -->
        <!-- ENCABEZADO -->
        <!-- ======================================================== -->
        <div class="historial-header">
            <div class="historial-titulo">
                <h1 class="titulo-reporte">
                    🚚 Reporte de Viajes de Material
                </h1>
                <p class="subtitulo-reporte">
                    Consulta el registro de viajes, volúmenes y control financiero por tipo de material.
                </p>
            </div>

            <div class="acciones-reporte no-print">
                <div class="accion-imprimir">
                    <button type="button"
                            class="btn btn-outline-primary btn-exportar btn-imprimir"
                            onclick="imprimirViajes()">
                        <i class="fa-solid fa-print"></i>
                        Imprimir
                    </button>
                </div>

                <div class="acciones-exportar">
                    <a asp-action="ExportarExcel"
                       class="btn btn-success btn-exportar">
                        <i class="fa-solid fa-file-excel"></i>
                        Exportar Excel
                    </a>

                    <a asp-action="ExportarPdf"
                       class="btn btn-danger btn-exportar">
                        <i class="fa-solid fa-file-pdf"></i>
                        Exportar PDF
                    </a>
                </div>
            </div>
        </div>


        <!-- ======================================================== -->
        <!-- ESTADÍSTICAS Y TARJETAS FINANCIERAS -->
        <!-- ======================================================== -->
        <div class="row g-3 mb-4 no-print">
            <div class="col-md-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted d-block fw-semibold">Total de Viajes</small>
                                <h3 class="fw-bold mb-0 text-dark">@totalViajes</h3>
                            </div>
                            <div class="fs-1 text-primary">
                                <i class="fa-solid fa-truck"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted d-block fw-semibold">Volumen Transportado</small>
                                <h3 class="fw-bold mb-0 text-success">
                                    @volumenTotal.ToString("N2") <small class="fs-6 text-muted">m³</small>
                                </h3>
                            </div>
                            <div class="fs-1 text-success">
                                <i class="fa-solid fa-cubes"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted d-block fw-semibold">Costo Total (Según Material)</small>
                                <h3 class="fw-bold mb-0 text-dark">
                                    $ @costoTotal.ToString("N0")
                                </h3>
                            </div>
                            <div class="fs-1 text-warning">
                                <i class="fa-solid fa-dollar-sign"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted d-block fw-semibold">Promedio m³ / Viaje</small>
                                <h3 class="fw-bold mb-0 text-info">
                                    @((totalViajes > 0 ? (volumenTotal / totalViajes) : 0).ToString("N2")) <small class="fs-6 text-muted">m³</small>
                                </h3>
                            </div>
                            <div class="fs-1 text-info">
                                <i class="fa-solid fa-chart-line"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <!-- ======================================================== -->
        <!-- TARJETA PRINCIPAL CON BARRA DE FILTROS ESTILO OPERADORES -->
        <!-- ======================================================== -->
        <div class="card border-0 shadow-sm">
            <div class="card-body px-4 py-4">

                <form method="get"
                      asp-controller="ViajeMaterial"
                      asp-action="Reporte"
                      id="filterForm"
                      class="no-print mb-4">

                    <!-- Barra de filtros en una sola línea fluida idéntica a Operadores -->
                    <div class="d-flex flex-wrap gap-3 align-items-center">

                        <!-- BUSCAR -->
                        <div class="flex-grow-1" style="min-width: 240px;">
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0" style="border-radius: 12px 0 0 12px;">
                                    <i class="fas fa-search text-muted"></i>
                                </span>
                                <input type="text"
                                       name="buscar"
                                       id="inputBuscar"
                                       value="@ViewBag.Buscar"
                                       class="form-control border-start-0 auto-submit"
                                       placeholder="Placa, recibidor, material..."
                                       autocomplete="off"
                                       style="border-radius: 0 12px 12px 0;" />
                            </div>
                        </div>

                        <!-- RECIBIDOR -->
                        <div style="width: 220px;">
                            <select name="recibidorId" class="form-select auto-submit">
                                <option value="">Todos los recibidores</option>
                                @if (ViewBag.Recibidores != null)
                                {
                                    foreach (var recibidor in ViewBag.Recibidores)
                                    {
                                        <option value="@recibidor.Id"
                                                selected="@(ViewBag.RecibidorId == recibidor.Id ? "selected" : null)">
                                            @recibidor.Nombre
                                        </option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- FRENTE OPERACIONAL -->
                        <div style="width: 200px;">
                            <select name="frenteOperacionalId" class="form-select auto-submit">
                                <option value="">Todos los frentes</option>
                                @if (ViewBag.FrentesOperacionales != null)
                                {
                                    foreach (var frente in ViewBag.FrentesOperacionales)
                                    {
                                        <option value="@frente.Id"
                                                selected="@(ViewBag.FrenteOperacionalId == frente.Id ? "selected" : null)">
                                            @frente.Nombre
                                        </option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- FECHA DESDE -->
                        <div style="width: 160px;">
                            <input type="date"
                                   name="desde"
                                   value="@ViewBag.Desde"
                                   class="form-control auto-submit"
                                   title="Fecha desde" />
                        </div>

                        <!-- FECHA HASTA -->
                        <div style="width: 160px;">
                            <input type="date"
                                   name="hasta"
                                   value="@ViewBag.Hasta"
                                   class="form-control auto-submit"
                                   title="Fecha hasta" />
                        </div>

                        <!-- BOTONES DE ACCIÓN (LIMPIAR Y NUEVO) -->
                        <div class="d-flex gap-2 ms-auto">
                            <a asp-controller="ViajeMaterial"
                               asp-action="Reporte"
                               class="btn btn-secondary d-flex align-items-center justify-content-center"
                               style="width: 48px; height: 48px; border-radius: 12px;"
                               title="Limpiar filtros">
                                <i class="fas fa-rotate-right"></i>
                            </a>

                        </div>

                    </div>
                </form>


                <!-- ================================== -->
                <!-- TABLA DE DATOS CON CABECERA AZUL -->
                <!-- ================================== -->
                <div class="historial-table-container">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Recibidor</th>
                                <th>Frente</th>
                                <th>Zona</th>
                                <th>Tramo</th>
                                <th>N.º Recibo</th>
                                <th>Placa</th>
                                <th>Material</th>
                                <th>Volumen (m³)</th>
                                <th>Costo ($)</th>
                                <th>Hora</th>
                                <th>Origen</th>
                                <th>Abscisa</th>
                                <th>Destino</th>
                                <th>Evidencia</th>
                                <th class="text-center no-print">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var viaje in Model)
                                {
                                    string matNombre = viaje.Material?.Trim() ?? "";
                                    decimal tarifaMaterial = tarifasMaterial.ContainsKey(matNombre) ? tarifasMaterial[matNombre] : tarifaPorDefecto;
                                    decimal costoViaje = viaje.VolumenM3 * tarifaMaterial;

                                    <tr>
                                        <td data-label="Fecha">@viaje.Fecha.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                        <td data-label="Recibidor"><span class="fw-semibold">@viaje.Recibidor?.Nombre</span></td>
                                        <td data-label="Frente">@viaje.FrenteOperacional?.Nombre</td>
                                        <td data-label="Zona">@viaje.Zona</td>
                                        <td data-label="Tramo">@viaje.Tramo</td>
                                        <td data-label="N.º Recibo">@viaje.NumeroRecibo</td>
                                        <td data-label="Placa"><span class="badge bg-secondary">@viaje.Placa</span></td>
                                        <td data-label="Material"><span class="fw-semibold text-primary">@viaje.Material</span></td>
                                        <td data-label="Volumen"><strong>@viaje.VolumenM3.ToString("N2")</strong> m³</td>
                                        <td data-label="Costo" class="text-success fw-bold">$ @costoViaje.ToString("N0")</td>
                                        <td data-label="Hora">@viaje.HoraLlegada.ToString("hh:mm tt", System.Globalization.CultureInfo.InvariantCulture)</td>
                                        <td data-label="Origen">@viaje.Origen</td>
                                        <td data-label="Abscisa">@viaje.AbscisaDescargue</td>
                                        <td data-label="Destino">@viaje.Destino</td>
                                        <td data-label="Evidencia">
                                            @if (!string.IsNullOrWhiteSpace(viaje.EvidenciaDescarga))
                                            {
                                                <a href="@viaje.EvidenciaDescarga"
                                                   target="_blank"
                                                   class="btn btn-sm btn-outline-primary"
                                                   title="Ver evidencia">
                                                    <i class="fa-solid fa-image"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Sin evidencia</span>
                                            }
                                        </td>
                                        <td class="text-center no-print acciones-tabla" data-label="Acciones">
                                            <a asp-action="Detalle"
                                               asp-route-id="@viaje.Id"
                                               class="btn btn-sm btn-primary"
                                               title="Ver viaje">
                                                <i class="fa-solid fa-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="16" class="text-center py-5">
                                        <i class="fa-solid fa-truck fa-2x text-muted mb-2"></i>
                                        <p class="mb-0 text-muted">No se encontraron viajes de material con los filtros seleccionados.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function imprimirViajes() {
            window.print();
        }

        // Filtros automáticos en tiempo real (sin necesidad de presionar buscar)
        document.addEventListener("DOMContentLoaded", function() {
            const form = document.getElementById("filterForm");
            const inputBuscar = document.getElementById("inputBuscar");
            const autoSubmits = document.querySelectorAll(".auto-submit");

            autoSubmits.forEach(element => {
                if (element !== inputBuscar) {
                    element.addEventListener("change", function() {
                        form.submit();
                    });
                }
            });

            let timeoutId;
            if (inputBuscar) {
                inputBuscar.addEventListener("input", function() {
                    clearTimeout(timeoutId);
                    timeoutId = setTimeout(() => {
                        form.submit();
                    }, 500);
                });
            }
        });
    </script>
}