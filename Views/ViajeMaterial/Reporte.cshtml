@model IEnumerable<FormularioMaquinaria.Models.ViajeMaterial>

@{
    ViewData["Title"] = "Reporte de Viajes de Material";
}

<link rel="stylesheet"
      href="~/css/historial.css"
      asp-append-version="true" />

<div class="container-fluid historial-page">

    <div id="viajeMaterialReporte">

        <!-- ========================================================
             ENCABEZADO
             ======================================================== -->

        <div class="historial-header">

            <div class="historial-titulo">

                <h1 class="titulo-reporte">
                    🚚 Reporte de Viajes de Material
                </h1>

                <p class="subtitulo-reporte">
                    Consulta todos los viajes de material registrados en el sistema.
                </p>

            </div>

            <div class="acciones-reporte no-print">

                <div class="accion-imprimir">

                    <button type="button"
                            class="btn btn-outline-primary btn-exportar btn-imprimir"
                            onclick="imprimirViajes()">

                        <i class="fa-solid fa-print"></i>

                        Imprimir

                    </button>

                </div>

                <div class="acciones-exportar">

                    <a asp-action="ExportarExcel"
                       class="btn btn-success btn-exportar">

                        <i class="fa-solid fa-file-excel"></i>

                        Exportar Excel

                    </a>

                    <a asp-action="ExportarPdf"
                       class="btn btn-danger btn-exportar">

                        <i class="fa-solid fa-file-pdf"></i>

                        Exportar PDF

                    </a>

                </div>

            </div>

        </div>


        <!-- ========================================================
             ESTADÍSTICAS
             ======================================================== -->

        <div class="row g-3 mb-4 no-print">

            <!-- TOTAL VIAJES -->

            <div class="col-md-6 col-xl-3">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>

                                <small class="text-muted d-block">
                                    Total de viajes
                                </small>

                                <h3 class="fw-bold mb-0">
                                    @ViewBag.TotalViajes
                                </h3>

                            </div>

                            <div class="fs-1 text-primary">

                                <i class="fa-solid fa-truck"></i>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- VOLUMEN TOTAL -->

            <div class="col-md-6 col-xl-3">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>

                                <small class="text-muted d-block">
                                    Volumen transportado
                                </small>

                                <h3 class="fw-bold mb-0">

                                    @(((decimal?)ViewBag.VolumenTotal ?? 0)
                                        .ToString("N2"))

                                    <small class="fs-6 text-muted">
                                        m³
                                    </small>

                                </h3>

                            </div>

                            <div class="fs-1 text-success">

                                <i class="fa-solid fa-box"></i>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ========================================================
             FILTROS
             ======================================================== -->

        <div class="card historial-card border-0">

            <div class="card-body">

                <form asp-action="Reporte"
                      method="get"
                      class="historial-form">

                    <div class="historial-toolbar no-print">


                        <!-- BÚSQUEDA -->

                        <div class="historial-search">

                            <div class="input-group historial-input-group">

                                <span class="input-group-text">

                                    <i class="fa-solid fa-magnifying-glass"></i>

                                </span>

                                <input type="text"
                                       name="buscar"
                                       class="form-control"
                                       placeholder="Buscar recibidor, placa, material, origen..."
                                       value="@ViewBag.Buscar" />

                            </div>

                        </div>


                        <!-- RECIBIDOR -->

                        <div class="historial-filtro">

                            <div class="select-wrapper">

                                <i class="fa-solid fa-user-check status-icon"></i>

                                <select name="recibidorId"
                                        class="form-select">

                                    <option value="">
                                        Todos los recibidores
                                    </option>

                                    @foreach (var recibidor in ViewBag.Recibidores)
                                    {
                                        <option value="@recibidor.Id"
                                                selected="@(ViewBag.RecibidorId == recibidor.Id ? "selected" : null)">

                                            @recibidor.Nombre

                                        </option>
                                    }

                                </select>

                            </div>

                        </div>


                        <!-- FRENTE OPERACIONAL -->

                        <div class="historial-filtro">

                            <div class="select-wrapper">

                                <i class="fa-solid fa-location-dot status-icon"></i>

                                <select name="frenteOperacionalId"
                                        class="form-select">

                                    <option value="">
                                        Todos los frentes
                                    </option>

                                    @foreach (var frente in ViewBag.FrentesOperacionales)
                                    {
                                        <option value="@frente.Id"
                                                selected="@(ViewBag.FrenteOperacionalId == frente.Id ? "selected" : null)">

                                            @frente.Nombre

                                        </option>
                                    }

                                </select>

                            </div>

                        </div>


                        <!-- FECHA DESDE -->

                        <div class="historial-filtro date-filter">

                            <div class="date-input-wrapper">

                                <i class="fa-regular fa-calendar-days date-icon"></i>

                                <span class="date-placeholder">
                                    Fecha desde
                                </span>

                                <input type="date"
                                       name="desde"
                                       class="form-control date-control"
                                       value="@ViewBag.Desde" />

                            </div>

                        </div>


                        <!-- FECHA HASTA -->

                        <div class="historial-filtro date-filter">

                            <div class="date-input-wrapper">

                                <i class="fa-regular fa-calendar-days date-icon"></i>

                                <span class="date-placeholder">
                                    Fecha hasta
                                </span>

                                <input type="date"
                                       name="hasta"
                                       class="form-control date-control"
                                       value="@ViewBag.Hasta" />

                            </div>

                        </div>


                        <!-- BOTONES -->

                        <div class="historial-acciones">

                            <button type="submit"
                                    class="btn btn-primary btn-toolbar-custom">

                                <i class="fa-solid fa-magnifying-glass"></i>

                                <span>
                                    Buscar
                                </span>

                            </button>


                            <a asp-action="Reporte"
                               class="btn btn-secondary btn-toolbar-custom">

                                <i class="fa-solid fa-rotate"></i>

                                <span>
                                    Limpiar
                                </span>

                            </a>


                            <a asp-action="Crear"
                               class="btn btn-success btn-toolbar-custom">

                                <i class="fa-solid fa-plus"></i>

                                <span>
                                    Nuevo
                                </span>

                            </a>

                        </div>

                    </div>

                </form>


                <!-- =================================================
                     TABLA
                     ================================================= -->

                <div class="historial-table-container">

                    <table class="table table-hover align-middle">

                        <thead>

                            <tr>

                                <th>
                                    Fecha
                                </th>

                                <th>
                                    Recibidor
                                </th>

                                <th>
                                    Frente
                                </th>

                                <th>
                                    Zona
                                </th>

                                <th>
                                    Tramo
                                </th>

                                <th>
                                    N.º Recibo
                                </th>

                                <th>
                                    Placa
                                </th>

                                <th>
                                    Volumen
                                </th>

                                <th>
                                    Material
                                </th>

                                <th>
                                    Hora
                                </th>

                                <th>
                                    Origen
                                </th>

                                <th>
                                    Abscisa
                                </th>

                                <th>
                                    Destino
                                </th>

                                <th>
                                    Evidencia
                                </th>

                                <th class="text-center no-print">
                                    Acciones
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @if (Model != null && Model.Any())
                            {

                                foreach (var viaje in Model)
                                {

                                    <tr>


                                        <!-- FECHA -->

                                        <td data-label="Fecha">

                                            @viaje.Fecha.ToLocalTime().ToString("dd/MM/yyyy")

                                        </td>


                                        <!-- RECIBIDOR -->

                                        <td data-label="Recibidor">

                                            <span class="fw-semibold">

                                                @viaje.Recibidor?.Nombre

                                            </span>

                                        </td>


                                        <!-- FRENTE -->

                                        <td data-label="Frente">

                                            @viaje.FrenteOperacional?.Nombre

                                        </td>


                                        <!-- ZONA -->

                                        <td data-label="Zona">

                                            @viaje.Zona

                                        </td>


                                        <!-- TRAMO -->

                                        <td data-label="Tramo">

                                            @viaje.Tramo

                                        </td>


                                        <!-- RECIBO -->

                                        <td data-label="N.º Recibo">

                                            @viaje.NumeroRecibo

                                        </td>


                                        <!-- PLACA -->

                                        <td data-label="Placa">

                                            <span class="badge bg-secondary">

                                                @viaje.Placa

                                            </span>

                                        </td>


                                        <!-- VOLUMEN -->

                                        <td data-label="Volumen">

                                            <strong>

                                                @viaje.VolumenM3.ToString("N2")

                                            </strong>

                                            m³

                                        </td>


                                        <!-- MATERIAL -->

                                        <td data-label="Material">

                                            @viaje.Material

                                        </td>


                                        <!-- HORA -->

                                        <td data-label="Hora">
                                            @viaje.HoraLlegada.ToString("hh:mm tt", System.Globalization.CultureInfo.InvariantCulture)
                                        </td>


                                        <!-- ORIGEN -->

                                        <td data-label="Origen">

                                            @viaje.Origen

                                        </td>


                                        <!-- ABSCISA -->

                                        <td data-label="Abscisa">

                                            @viaje.AbscisaDescargue

                                        </td>


                                        <!-- DESTINO -->

                                        <td data-label="Destino">

                                            @viaje.Destino

                                        </td>


                                        <!-- EVIDENCIA -->

                                        <td data-label="Evidencia">

                                            @if (!string.IsNullOrWhiteSpace(
                                                viaje.EvidenciaDescarga))
                                            {

                                                <a href="@viaje.EvidenciaDescarga"
                                                   target="_blank"
                                                   class="btn btn-sm btn-outline-primary"
                                                   title="Ver evidencia">

                                                    <i class="fa-solid fa-image"></i>

                                                </a>

                                            }
                                            else
                                            {

                                                <span class="text-muted">
                                                    Sin evidencia
                                                </span>

                                            }

                                        </td>


                                        <!-- ACCIONES -->

                                        <td class="text-center no-print acciones-tabla"
                                            data-label="Acciones">

                                            <a asp-action="Detalle"
                                               asp-route-id="@viaje.Id"
                                               class="btn btn-sm btn-primary"
                                               title="Ver viaje">

                                                <i class="fa-solid fa-eye"></i>

                                            </a>

                                        </td>

                                    </tr>

                                }

                            }
                            else
                            {

                                <tr>

                                    <td colspan="15"
                                        class="text-center py-5">

                                        <i class="fa-solid fa-truck fa-2x text-muted mb-2"></i>

                                        <p class="mb-0 text-muted">

                                            No se encontraron viajes de material.

                                        </p>

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        function imprimirViajes() {

            window.print();

        }

    </script>

}