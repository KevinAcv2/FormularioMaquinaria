@{
    Layout = "_ReporteLayout";
    ViewData["Title"] = "Inicio";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

<style>
    body {
        background: linear-gradient(rgba(0,0,0,.55), rgba(0,0,0,.55)), url('/img/Fondo.jpg') no-repeat center center fixed;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
        min-height: 100vh;
    }

    .card-industrial {
        border-radius: 25px;
        overflow: hidden;
        border: none;
        background: rgba(255,255,255,0.96);
        backdrop-filter: blur(10px);
    }

    .header-industrial {
        background: #0f2f44; 
        padding: 35px;
        text-align: center;
        color: white;
    }

    .logo-empresa {
        width: 120px;
        height: 120px;
        object-fit: cover;
        border-radius: 50%;
        border: 5px solid #f0ad00;
        margin-bottom: 15px;
    }

    .btn-industrial {
        background: #f0ad00;
        color: #000;
        font-weight: 800;
        border-radius: 12px;
        padding: 12px;
        border: none;
    }

        .btn-industrial:hover {
            background: #d89b00;
            transform: scale(1.02);
        }

    .btn-menu {
        font-weight: 800;
        border-radius: 12px;
        padding: 12px;
        font-size: 16px;
    }
</style>

<div class="container vh-100 d-flex align-items-center justify-content-center">

    <div class="card shadow-lg card-industrial text-center" style="max-width:600px;width:100%;">

        <!-- HEADER AZUL IGUAL AL REPORTE -->
        <div class="header-industrial">

            <img src="~/img/Logo.png" class="logo-empresa" />

            <h1 class="fw-bold">AVENIDA DEL RÍO</h1>

            <p class="mb-0">
                Sistema Web de Gestión de Maquinaria
            </p>

        </div>

        <!-- CUERPO -->
        <div class="p-5">

            <p class="text-muted mb-4">
                Bienvenido al sistema de control operacional
            </p>

            <a href="/Reporte/Crear" class="btn btn-industrial w-100 mb-3">
                <i class="fas fa-file-alt"></i> Registrar Reporte
            </a>

            <a href="/Login/Index" class="btn btn-primary btn-menu w-100">
                <i class="fas fa-user-shield"></i> Administración
            </a>

        </div>

    </div>

</div>